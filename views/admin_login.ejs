<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Ravenzena Bot</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: { base: '#050505', surface: '#111111', border: '#262626', accent: '#3B82F6' }
                }
            }
        }
    </script>
    <style>
        body { background-color: #050505; color: #E5E7EB; }
        .grid-lines { background-image: linear-gradient(to right, #111111 1px, transparent 1px), linear-gradient(to bottom, #111111 1px, transparent 1px); background-size: 40px 40px; }
    </style>
</head>
<body class="antialiased min-h-screen flex items-center justify-center p-6">
    <div class="fixed inset-0 grid-lines z-0 opacity-30"></div>
    <div class="relative z-10 w-full max-w-md">
        <div class="bg-surface border border-border p-8 rounded-3xl shadow-2xl">
            <div class="text-center mb-8">
                <img src="/favicon.png" alt="Logo" class="w-12 h-12 mx-auto mb-4 rounded-xl">
                <h1 class="text-2xl font-bold text-white">Admin Access</h1>
                <p class="text-gray-400 text-sm">Silakan login untuk mengelola pesanan.</p>
            </div>
            <form action="/user/admin" method="POST" class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-400 mb-2">Username</label>
                    <input type="text" name="username" required value="admin" class="w-full bg-base border border-border rounded-xl px-4 py-3 text-white focus:border-accent outline-none transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-400 mb-2">Password</label>
                    <input type="password" name="password" required class="w-full bg-base border border-border rounded-xl px-4 py-3 text-white focus:border-accent outline-none transition-all">
                </div>
                <% if (typeof error !== 'undefined' && error) { %>
                    <p class="text-red-500 text-xs text-center"><%= error %></p>
                <% } %>
                <button type="submit" class="w-full bg-white text-black font-bold py-4 rounded-xl hover:bg-gray-200 transition-all">Login</button>
            </form>
        </div>
    </div>
</body>
</html>
