                            <div class="py-12 text-center text-zinc-500 bg-[#121212] border border-white/5 rounded-2xl">Belum ada grup aktif.</div>
                        <% } else { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                <% activeGroups.forEach(group => { %>
                                <div class="bg-[#121212] border border-white/5 rounded-2xl p-4 flex items-center gap-4 hover:border-white/10 transition-colors">
                                    <!-- Image -->
                                    <div class="relative shrink-0">
                                        <% if(group.photo) { %>
                                            <img src="<%= group.photo %>" alt="Photo" class="w-14 h-14 rounded-full object-cover border border-red-500/50 p-0.5">
                                        <% } else { %>
                                            <div class="w-14 h-14 rounded-full bg-zinc-800 flex items-center justify-center border border-red-500/50 p-0.5"><i class="fas fa-users text-zinc-500"></i></div>
                                        <% } %>
                                    </div>
                                    
                                    <!-- Info -->
                                    <div class="flex-1 min-w-0 flex flex-col justify-center">
                                        <!-- Name -->
                                        <h4 class="text-base font-extrabold text-white truncate uppercase tracking-wide"><%= group.name || 'GRUP TIDAK DIKENAL' %></h4>
                                        
                                        <!-- Bot Type -->
                                        <div class="text-[13px] text-zinc-400 mt-0.5 flex items-center gap-1.5 font-medium">
                                            <i class="fa-solid fa-robot text-[11px]"></i>
                                            <span class="capitalize"><%= group.jenisBot || 'Bot' %></span>
                                        </div>
                                        
                                        <!-- Timer / Order ID -->
                                        <div class="mt-2.5 flex items-center gap-2">
                                            <% if(group.expiredAt) { %>
                                                <div class="countdown-timer inline-flex items-center px-2.5 py-1 bg-[#1a1a1a] rounded-md font-mono text-[11px] font-bold text-zinc-300 border border-white/5" data-expire="<%= group.expiredAt %>">Masa aktif ...</div>
                                            <% } else { %>
                                                <div class="inline-flex items-center px-2.5 py-1 bg-[#1a1a1a] rounded-md font-mono text-[11px] font-bold text-zinc-300 border border-white/5">Permanent</div>
                                            <% } %>
                                            
                                            <!-- Tooltip or tiny indicator for Order ID -->
                                            <span class="text-[9px] font-mono text-purple-400/50 ml-auto" title="Order ID"><%= group.orderId %></span>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                            </div>
                        <% } %>
