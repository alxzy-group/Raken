                                        <span>Sisa Slot:</span>
                                        <span id="slot_v3_rem_info" class="font-mono <%= bGuild.remainingSlots > 0 ? 'text-green-400' : 'text-red-400' %>"><%= bGuild.remainingSlots %> slot</span>
                                    </div>
                                </div>
                            </div>

                            <!-- CARD: BOT CC -->
                            <div class="glass-card p-6 flex flex-col justify-between border-t-4 border-t-amber-500">
