<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Kelola pesanan, grup aktif, voucher, dan identitas website.">
    <title>Admin Dashboard | Ravenzena Bot</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
                    colors: {
                        base: '#09090b',
                        surface: 'rgba(24, 24, 27, 0.45)',
                        border: 'rgba(255, 255, 255, 0.08)',
                        accent: '#a855f7', 
                        accentHover: '#9333ea',
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #09090b; color: #f4f4f5; font-family: 'Inter', sans-serif; min-height: 100vh; overflow-x: hidden; }
        
        /* Grid Background Pattern */
        .grid-bg {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            z-index: -2;
            pointer-events: none;
        }

        /* Ambient Glow */
        .ambient-glow {
            position: fixed;
            top: -150px; left: 50%; transform: translateX(-50%);
            width: 800px; height: 400px;
            background: radial-gradient(circle, rgba(168, 85, 247, 0.15) 0%, transparent 60%);
            z-index: -1;
            pointer-events: none;
        }

        /* Glass Cards */
        .glass-card {
            background: rgba(24, 24, 27, 0.6);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
            border-radius: 1rem;
        }

        /* Input Fields */
        .premium-input {
            background: rgba(9, 9, 11, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #f4f4f5;
            transition: all 0.2s ease;
        }
        .premium-input:focus {
            border-color: #a855f7;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.2);
            outline: none;
        }

        /* Nav Item Active State */
        .nav-item {
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .nav-item.active {
            background: rgba(168, 85, 247, 0.15);
            color: #d8b4fe;
            border-right: 3px solid #a855f7;
        }
        .nav-item:hover:not(.active) {
            background: rgba(255, 255, 255, 0.05);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #09090b; }
        ::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #52525b; }

        .fade-in { animation: fadeIn 0.3s ease forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Mobile Nav Active State */
        .nav-item-mobile {
            transition: all 0.2s ease;
        }
        .nav-item-mobile.active {
            color: #d8b4fe;
        }
        .nav-item-mobile.active i {
            color: #a855f7;
            transform: scale(1.1);
        }
    </style>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="antialiased selection:bg-purple-500/30">

    <div class="grid-bg"></div>
    <div class="ambient-glow"></div>

    <div class="flex h-screen overflow-hidden">
        
        <!-- Sidebar -->
        <aside class="w-64 flex-shrink-0 border-r border-white/10 glass-card m-4 mr-0 rounded-2xl flex flex-col hidden md:flex overflow-y-auto z-20">
            <div class="p-6 pb-2">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-purple-500/20 flex items-center justify-center border border-purple-500/30">
                        <i class="fas fa-robot text-purple-400 text-lg"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-white tracking-tight">Admin Panel</h1>
                        <p class="text-xs text-zinc-400">Ravenzena Bot</p>
                    </div>
                </div>
            </div>

            <div class="px-4 py-6 flex-1 flex flex-col gap-1">
                <div class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-2 ml-2">Main</div>
                <div class="nav-item active flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-dashboard" onclick="switchTab('section-dashboard')">
                    <i class="fas fa-home w-5 text-center"></i> Dashboard
                </div>
                <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-groups" onclick="switchTab('section-groups')">
                    <i class="fas fa-users w-5 text-center"></i> Grup Aktif
                </div>

                <div class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-2 ml-2 mt-6">Konfigurasi</div>
                <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-pricing" onclick="switchTab('section-pricing')">
                    <i class="fas fa-tags w-5 text-center"></i> Harga Paket
                </div>
                <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-vouchers" onclick="switchTab('section-vouchers')">
                    <i class="fas fa-ticket-alt w-5 text-center"></i> Voucher Diskon
                </div>
                <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-settings" onclick="switchTab('section-settings')">
                    <i class="fas fa-cog w-5 text-center"></i> Pengaturan
                </div>
            </div>

            <div class="p-4 border-t border-white/10">
                <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300 hover:bg-white/5 transition-colors mb-1">
                    <i class="fas fa-external-link-alt w-5 text-center"></i> Lihat Website
                </a>
                <a href="/user/admin/logout" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-red-400 hover:bg-red-500/10 transition-colors">
                    <i class="fas fa-sign-out-alt w-5 text-center"></i> Logout
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 h-full overflow-y-auto p-4 md:p-8 z-10 scroll-smooth pb-20">
            
            <!-- SECTION: DASHBOARD -->
            <div id="section-dashboard" class="tab-content fade-in">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-3xl font-extrabold text-white tracking-tight">Ringkasan Sistem</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div class="glass-card p-6 flex items-center gap-6">
                        <div class="w-14 h-14 rounded-xl bg-blue-500/20 border border-blue-500/30 flex items-center justify-center text-blue-400 text-2xl">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <div>
                            <p class="text-zinc-400 text-sm font-medium">Total Pesanan</p>
                            <h3 class="text-3xl font-bold text-white"><%= orders.length %></h3>
                        </div>
                    </div>
                    <div class="glass-card p-6 flex items-center gap-6">
                        <div class="w-14 h-14 rounded-xl bg-green-500/20 border border-green-500/30 flex items-center justify-center text-green-400 text-2xl">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <p class="text-zinc-400 text-sm font-medium">Grup Aktif</p>
                            <h3 class="text-3xl font-bold text-white"><%= activeGroups.length %></h3>
                        </div>
                    </div>
                </div>

                <!-- Charts Section -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                    <div class="glass-card p-6 lg:col-span-2">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-semibold text-white">Tren Pesanan</h3>
                            <div class="text-xs font-semibold text-purple-400 bg-purple-500/10 px-3 py-1 rounded-full border border-purple-500/20">7 Hari Terakhir</div>
                        </div>
                        <div class="relative h-64 w-full">
                            <canvas id="ordersChart"></canvas>
                        </div>
                    </div>
                    <div class="glass-card p-6 lg:col-span-1">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-semibold text-white">Distribusi Paket</h3>
                        </div>
                        <div class="relative h-64 w-full flex items-center justify-center">
                            <canvas id="packageChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="glass-card overflow-hidden">
                    <div class="p-6 border-b border-white/10 flex items-center gap-3">
                        <i class="fas fa-list text-purple-400"></i>
                        <h3 class="text-lg font-semibold text-white">Pesanan Terakhir</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-zinc-300">
                            <thead class="bg-white/5 text-zinc-400 font-medium">
                                <tr>
                                    <th class="px-6 py-4">ID Order</th>
                                    <th class="px-6 py-4">Status</th>
                                    <th class="px-6 py-4">Bot</th>
                                    <th class="px-6 py-4">Paket</th>
                                    <th class="px-6 py-4">Harga</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                <% if(orders.length === 0) { %>
                                    <tr><td colspan="5" class="px-6 py-12 text-center text-zinc-500">Belum ada pesanan masuk.</td></tr>
                                <% } else { %>
                                    <% orders.slice(0, 10).forEach(order => { %>
                                    <tr class="hover:bg-white/5 transition-colors">
                                        <td class="px-6 py-4 font-mono text-purple-400"><%= order.id %></td>
                                        <td class="px-6 py-4">
                                            <% if(order.status === 'PAID') { %>
                                                <span class="px-2.5 py-1 bg-green-500/20 text-green-400 border border-green-500/30 rounded-full text-xs font-bold">LUNAS</span>
                                            <% } else { %>
                                                <span class="px-2.5 py-1 bg-yellow-500/20 text-yellow-400 border border-yellow-500/30 rounded-full text-xs font-bold">PENDING</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 uppercase font-semibold"><%= order.jenis_bot %></td>
                                        <td class="px-6 py-4"><%= order.paket %> (<%= order.tipe_order %>)</td>
                                        <td class="px-6 py-4 font-semibold text-white">Rp <%= order.harga.toLocaleString('id-ID') %></td>
                                    </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- SECTION: GROUPS -->
            <div id="section-groups" class="tab-content hidden fade-in">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-3xl font-extrabold text-white tracking-tight">Grup Aktif</h2>
                </div>
                <!-- Active Groups Table -->
                <div class="glass-card overflow-hidden">
                    <div class="p-6 border-b border-white/10 flex items-center gap-3">
                        <i class="fas fa-users text-green-400"></i>
                        <h3 class="text-lg font-semibold text-white">Daftar Grup Aktif</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-zinc-300">
                            <thead class="bg-white/5 text-zinc-400 font-medium">
                                <tr>
                                    <th class="px-6 py-4">Grup</th>
                                    <th class="px-6 py-4">Status</th>
                                    <th class="px-6 py-4">Order ID</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                <% if(activeGroups.length === 0) { %>
                                    <tr><td colspan="3" class="px-6 py-12 text-center text-zinc-500">Belum ada grup aktif.</td></tr>
                                <% } else { %>
                                    <% activeGroups.forEach(group => { %>
                                    <tr class="hover:bg-white/5 transition-colors">
                                        <td class="px-6 py-4 flex items-center gap-3">
                                            <% if(group.photo) { %>
                                                <img src="<%= group.photo %>" alt="Grup Photo" class="w-10 h-10 rounded-full object-cover border border-white/10">
                                            <% } else { %>
                                                <div class="w-10 h-10 rounded-full bg-zinc-800 flex items-center justify-center border border-white/10"><i class="fas fa-users text-zinc-500"></i></div>
                                            <% } %>
                                            <div>
                                                <div class="font-semibold text-white"><%= group.name || 'Grup Tidak Dikenal' %></div>
                                                <div class="text-xs text-zinc-500 font-mono"><%= group.jid || 'N/A' %></div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="px-2.5 py-1 bg-green-500/20 text-green-400 border border-green-500/30 rounded-full text-xs font-bold">AKTIF</span>
                                        </td>
                                        <td class="px-6 py-4 font-mono text-xs text-purple-400"><%= group.orderId %></td>
                                    </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- SECTION: PRICING -->
            <div id="section-pricing" class="tab-content hidden">
                <div class="max-w-4xl">
                    <h2 class="text-3xl font-extrabold text-white tracking-tight mb-2">Harga Paket Bot</h2>
                    <p class="text-zinc-400 mb-8">Ubah struktur harga dan masa aktif paket. Data ditarik dari database Anda.</p>
                    
                    <div class="glass-card p-1">
                        <div class="p-6 border-b border-white/10 flex items-center gap-3">
                            <i class="fas fa-code text-purple-400"></i>
                            <h3 class="text-lg font-semibold text-white">JSON Editor (Live)</h3>
                        </div>
                        <div class="p-6">
                            <form id="pricingForm" onsubmit="savePricingConfig(event)">
                                <div class="relative group">
                                    <textarea id="pricingJsonInput" rows="20" class="premium-input w-full rounded-xl p-6 font-mono text-sm leading-relaxed" placeholder="Loading data..."></textarea>
                                </div>
                                <div id="pricingMessage" class="mt-4 hidden px-4 py-3 rounded-lg text-sm font-medium"></div>
                                <div class="mt-6">
                                    <button type="submit" id="pricingSubmit" class="bg-purple-500 hover:bg-purple-600 text-white px-8 py-3 rounded-xl font-semibold shadow-lg shadow-purple-500/25 transition-all flex items-center gap-2">
                                        <i class="fas fa-save"></i> Simpan Harga
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION: VOUCHERS -->
            <div id="section-vouchers" class="tab-content hidden">
                <div class="max-w-5xl">
                    <h2 class="text-3xl font-extrabold text-white tracking-tight mb-2">Voucher Diskon</h2>
                    <p class="text-zinc-400 mb-8">Buat kode promo baru untuk menarik lebih banyak pembeli.</p>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <div class="lg:col-span-1">
                            <div class="glass-card p-6">
                                <h3 class="text-lg font-semibold text-white mb-6 border-b border-white/10 pb-4">Buat Voucher Baru</h3>
                                <form id="voucherForm" onsubmit="createVoucher(event)" class="space-y-4">
                                    <div>
                                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Kode Voucher</label>
                                        <input type="text" id="voucherCode" required class="premium-input w-full rounded-lg px-4 py-2.5 font-mono uppercase" placeholder="PROMO2026">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Diskon (%)</label>
                                        <input type="number" id="voucherDiscount" required min="1" max="100" class="premium-input w-full rounded-lg px-4 py-2.5" placeholder="10">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Maks Penggunaan (0 = Tak Terbatas)</label>
                                        <input type="number" id="voucherMax" required min="0" value="0" class="premium-input w-full rounded-lg px-4 py-2.5">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Target Bot</label>
                                        <select id="voucherBot" class="premium-input w-full rounded-lg px-4 py-2.5">
                                            <option value="all">Semua Bot</option>
                                            <option value="store">Store</option>
                                            <option value="v3">V3</option>
                                            <option value="cc">CC</option>
                                        </select>
                                    </div>
                                    <div id="voucherMessage" class="hidden px-4 py-2 rounded-lg text-sm font-medium"></div>
                                    <button type="submit" id="voucherSubmit" class="w-full bg-purple-500 hover:bg-purple-600 text-white py-3 rounded-lg font-semibold shadow-lg shadow-purple-500/25 transition-all mt-4">
                                        Buat Voucher
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="lg:col-span-2">
                            <div class="glass-card overflow-hidden">
                                <div class="p-6 border-b border-white/10 flex items-center justify-between">
                                    <h3 class="text-lg font-semibold text-white">Daftar Voucher Aktif</h3>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left text-sm text-zinc-300">
                                        <thead class="bg-white/5 text-zinc-400 font-medium">
                                            <tr>
                                                <th class="px-6 py-4">Kode</th>
                                                <th class="px-6 py-4">Bot</th>
                                                <th class="px-6 py-4">Diskon</th>
                                                <th class="px-6 py-4">Terpakai</th>
                                                <th class="px-6 py-4 text-right">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-white/5">
                                            <% if(vouchers.length === 0) { %>
                                                <tr><td colspan="5" class="px-6 py-12 text-center text-zinc-500">Belum ada voucher aktif.</td></tr>
                                            <% } else { %>
                                                <% vouchers.forEach(v => { %>
                                                <tr class="hover:bg-white/5 transition-colors">
                                                    <td class="px-6 py-4 font-mono font-bold text-purple-400"><%= v.code %></td>
                                                    <td class="px-6 py-4"><span class="px-2 py-1 bg-white/10 rounded text-xs uppercase"><%= v.jenisBot %></span></td>
                                                    <td class="px-6 py-4 font-semibold text-white"><%= v.discount %>%</td>
                                                    <td class="px-6 py-4"><%= v.usedCount %> / <%= v.maxUsage === 0 ? '∞' : v.maxUsage %></td>
                                                    <td class="px-6 py-4 text-right">
                                                        <button onclick="deleteVoucher('<%= v.id %>')" class="text-red-400 hover:text-red-300 p-2 bg-red-500/10 hover:bg-red-500/20 rounded-lg transition-colors">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION: SETTINGS -->
            <div id="section-settings" class="tab-content hidden">
                <div class="max-w-4xl">
                    <h2 class="text-3xl font-extrabold text-white tracking-tight mb-2">Pengaturan Sistem</h2>
                    <p class="text-zinc-400 mb-8">Konfigurasikan integrasi pihak ketiga dan identitas visual website.</p>

                    <form id="settingsForm" onsubmit="saveSettings(event)">
                        <div class="glass-card p-8 mb-6">
                            <h3 class="text-xl font-semibold text-white mb-6 border-b border-white/10 pb-4 flex items-center gap-3">
                                <i class="fas fa-plug text-purple-400"></i> Integrasi API
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">MustikaPay API Key</label>
                                    <input type="text" id="mustikaApiKey" value="<%= mustikaApiKey || '' %>" class="premium-input w-full rounded-lg px-4 py-3 font-mono">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Telegram Bot Token</label>
                                    <input type="text" id="telegramBotToken" value="<%= telegramBotToken || '' %>" class="premium-input w-full rounded-lg px-4 py-3 font-mono">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Telegram Owner ID</label>
                                    <input type="text" id="telegramOwnerId" value="<%= telegramOwnerId || '' %>" class="premium-input w-full rounded-lg px-4 py-3 font-mono">
                                </div>
                            </div>
                        </div>

                        <div class="glass-card p-8 mb-6">
                            <h3 class="text-xl font-semibold text-white mb-6 border-b border-white/10 pb-4 flex items-center gap-3">
                                <i class="fas fa-paint-brush text-purple-400"></i> Identitas Website
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Nama Website</label>
                                    <input type="text" id="siteName" value="<%= siteSettings && siteSettings.siteName ? siteSettings.siteName : '' %>" class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">URL Logo</label>
                                    <div class="flex gap-2">
                                        <input type="url" id="logoUrl" value="<%= siteSettings && siteSettings.logoUrl ? siteSettings.logoUrl : '' %>" class="premium-input w-full rounded-lg px-4 py-3">
                                        <label class="bg-purple-500/20 text-purple-400 border border-purple-500/30 rounded-lg px-4 flex items-center justify-center cursor-pointer hover:bg-purple-500/30 transition-all" title="Upload Logo">
                                            <i class="fas fa-upload"></i>
                                            <input type="file" class="hidden" onchange="uploadImage(this, 'logoUrl', false)">
                                        </label>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">URL Favicon</label>
                                    <div class="flex gap-2">
                                        <input type="url" id="faviconUrl" value="<%= siteSettings && siteSettings.faviconUrl ? siteSettings.faviconUrl : '' %>" placeholder="/favicon.png" class="premium-input w-full rounded-lg px-4 py-3">
                                        <label class="bg-purple-500/20 text-purple-400 border border-purple-500/30 rounded-lg px-4 flex items-center justify-center cursor-pointer hover:bg-purple-500/30 transition-all" title="Upload Favicon (Auto convert to ICO)">
                                            <i class="fas fa-upload"></i>
                                            <input type="file" class="hidden" onchange="uploadImage(this, 'faviconUrl', true)">
                                        </label>
                                    </div>
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">URL Gambar Hero (Thumbnail)</label>
                                    <div class="flex gap-2">
                                        <input type="url" id="heroImageUrl" value="<%= siteSettings && siteSettings.heroImageUrl ? siteSettings.heroImageUrl : '' %>" class="premium-input w-full rounded-lg px-4 py-3">
                                        <label class="bg-purple-500/20 text-purple-400 border border-purple-500/30 rounded-lg px-4 flex items-center justify-center cursor-pointer hover:bg-purple-500/30 transition-all" title="Upload Gambar Hero">
                                            <i class="fas fa-upload"></i>
                                            <input type="file" class="hidden" onchange="uploadImage(this, 'heroImageUrl', false)">
                                        </label>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Nomor WhatsApp 1</label>
                                    <input type="text" id="whatsappNumber1" value="<%= siteSettings && siteSettings.whatsappNumber1 ? siteSettings.whatsappNumber1 : '' %>" placeholder="628..." class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Nomor WhatsApp 2 (Opsional)</label>
                                    <input type="text" id="whatsappNumber2" value="<%= siteSettings && siteSettings.whatsappNumber2 ? siteSettings.whatsappNumber2 : '' %>" placeholder="628..." class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Nomor WhatsApp 3 (Opsional)</label>
                                    <input type="text" id="whatsappNumber3" value="<%= siteSettings && siteSettings.whatsappNumber3 ? siteSettings.whatsappNumber3 : '' %>" placeholder="628..." class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Nomor WhatsApp 4 (Opsional)</label>
                                    <input type="text" id="whatsappNumber4" value="<%= siteSettings && siteSettings.whatsappNumber4 ? siteSettings.whatsappNumber4 : '' %>" placeholder="628..." class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Link Grup Gratis</label>
                                    <input type="url" id="freeGroupLink" value="<%= siteSettings && siteSettings.freeGroupLink ? siteSettings.freeGroupLink : '' %>" placeholder="https://chat.whatsapp.com/..." class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Deskripsi Website</label>
                                    <textarea id="siteDescription" rows="3" class="premium-input w-full rounded-lg px-4 py-3"><%= siteSettings && siteSettings.siteDescription ? siteSettings.siteDescription : '' %></textarea>
                                </div>
                            </div>
                        </div>

                        <div id="settingsMessage" class="hidden px-4 py-3 rounded-lg text-sm font-medium mb-6"></div>
                        
                        <button type="submit" id="settingsSubmit" class="bg-purple-500 hover:bg-purple-600 text-white px-8 py-3.5 rounded-xl font-semibold shadow-lg shadow-purple-500/25 transition-all flex items-center gap-2">
                            <i class="fas fa-check-circle"></i> Simpan Pengaturan
                        </button>
                    </form>
                </div>
            </div>

        </main>
    </div>

    <!-- Mobile Bottom Nav -->
    <div class="md:hidden fixed bottom-0 w-full bg-[#09090b]/90 backdrop-blur-xl border-t border-white/10 z-50 flex justify-around p-2 pb-4">
        <div class="nav-item-mobile active flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-dashboard" onclick="switchTab('section-dashboard')">
            <i class="fas fa-home text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Home</span>
        </div>
        <div class="nav-item-mobile flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-groups" onclick="switchTab('section-groups')">
            <i class="fas fa-users text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Grup</span>
        </div>
        <div class="nav-item-mobile flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-pricing" onclick="switchTab('section-pricing')">
            <i class="fas fa-tags text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Harga</span>
        </div>
        <div class="nav-item-mobile flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-vouchers" onclick="switchTab('section-vouchers')">
            <i class="fas fa-ticket-alt text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Voucher</span>
        </div>
        <div class="nav-item-mobile flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-settings" onclick="switchTab('section-settings')">
            <i class="fas fa-cog text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Setelan</span>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        // Tab Navigation Logic
        function switchTab(targetId) {
            // Update nav items
            document.querySelectorAll('.nav-item').forEach(el => {
                if(el.dataset.target === targetId) {
                    el.classList.add('active');
                } else {
                    el.classList.remove('active');
                }
            });

            // Update mobile nav items
            document.querySelectorAll('.nav-item-mobile').forEach(el => {
                if(el.dataset.target === targetId) {
                    el.classList.add('active');
                    el.classList.replace('text-zinc-500', 'text-purple-400');
                } else {
                    el.classList.remove('active');
                    el.classList.replace('text-purple-400', 'text-zinc-500');
                }
            });

            // Update content sections
            document.querySelectorAll('.tab-content').forEach(el => {
                if(el.id === targetId) {
                    el.classList.remove('hidden');
                    el.classList.add('fade-in');
                } else {
                    el.classList.add('hidden');
                    el.classList.remove('fade-in');
                }
            });

            // Trigger specific load actions per tab
            if(targetId === 'section-pricing') {
                loadPricingConfig();
            }
        }

        // PRICING LOGIC
        async function loadPricingConfig() {
            const textarea = document.getElementById('pricingJsonInput');
            try {
                textarea.value = "Memuat data dari database...";
                const res = await fetch('/user/admin/pricing');
                const data = await res.json();
                if (data.success && data.data) {
                    textarea.value = JSON.stringify(data.data, null, 4);
                } else {
                    textarea.value = "Gagal memuat harga. Gunakan config.js default.";
                }
            } catch (err) {
                console.error(err);
                textarea.value = "Koneksi ke server gagal.";
            }
        }

        async function savePricingConfig(e) {
            e.preventDefault();
            const btn = document.getElementById('pricingSubmit');
            const msg = document.getElementById('pricingMessage');
            const val = document.getElementById('pricingJsonInput').value;
            
            let parsed = null;
            try {
                parsed = JSON.parse(val);
            } catch (err) {
                msg.innerText = "Format JSON salah! Perhatikan tanda kutip dan kurung kurawal.";
                msg.className = "mt-4 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';
            msg.classList.add('hidden');

            try {
                const res = await fetch('/user/admin/pricing', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ pricing: parsed })
                });
                const data = await res.json();
                if(data.success) {
                    msg.innerText = "Harga berhasil disimpan dan langsung aktif!";
                    msg.className = "mt-4 px-4 py-3 rounded-lg text-sm font-medium bg-green-500/10 text-green-400 border border-green-500/20";
                } else {
                    msg.innerText = data.message || "Gagal menyimpan.";
                    msg.className = "mt-4 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                }
                msg.classList.remove('hidden');
            } catch (err) {
                msg.innerText = "Terjadi kesalahan koneksi saat menyimpan.";
                msg.className = "mt-4 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save"></i> Simpan Harga';
            }
        }

        // VOUCHER LOGIC
        async function createVoucher(e) {
            e.preventDefault();
            const btn = document.getElementById('voucherSubmit');
            const msg = document.getElementById('voucherMessage');
            
            const payload = {
                code: document.getElementById('voucherCode').value,
                discount: document.getElementById('voucherDiscount').value,
                maxUsage: document.getElementById('voucherMax').value,
                jenisBot: document.getElementById('voucherBot').value,
                expiry: ''
            };

            btn.disabled = true;
            btn.innerText = 'Membuat...';
            msg.classList.add('hidden');

            try {
                const res = await fetch('/user/admin/vouchers', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    msg.innerText = data.message;
                    msg.className = "mt-4 px-4 py-2 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                    msg.classList.remove('hidden');
                    btn.disabled = false;
                    btn.innerText = 'Buat Voucher';
                }
            } catch (err) {
                msg.innerText = "Server Error";
                msg.className = "mt-4 px-4 py-2 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
                btn.disabled = false;
                btn.innerText = 'Buat Voucher';
            }
        }

        async function deleteVoucher(id) {
            if(!confirm('Hapus voucher ini secara permanen?')) return;
            try {
                await fetch('/user/admin/vouchers/' + id, { method: 'DELETE' });
                window.location.reload();
            } catch (e) {
                alert('Gagal menghapus voucher');
            }
        }

        // SETTINGS LOGIC
        async function uploadImage(input, targetId, convertToIco) {
            if(!input.files || input.files.length === 0) return;
            const file = input.files[0];
            const msg = document.getElementById('settingsMessage');
            const targetInput = document.getElementById(targetId);
            
            const formData = new FormData();
            formData.append('file', file);
            if (convertToIco) formData.append('convertToIco', 'true');

            const originalValue = targetInput.value;
            targetInput.value = 'Mengupload...';
            
            try {
                const res = await fetch('/user/admin/upload', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if(data.success) {
                    targetInput.value = data.url;
                    msg.innerText = "Gambar berhasil diupload!";
                    msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-green-500/10 text-green-400 border border-green-500/20";
                    msg.classList.remove('hidden');
                } else {
                    targetInput.value = originalValue;
                    msg.innerText = data.message || "Gagal mengupload.";
                    msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                    msg.classList.remove('hidden');
                }
            } catch(err) {
                targetInput.value = originalValue;
                msg.innerText = "Koneksi terputus saat upload.";
                msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
            }
            
            // Clear file input so same file can be uploaded again if needed
            input.value = '';
        }

        async function saveSettings(e) {
            e.preventDefault();
            const btn = document.getElementById('settingsSubmit');
            const msg = document.getElementById('settingsMessage');
            
            const payload = {
                telegramBotToken: document.getElementById('telegramBotToken').value,
                telegramOwnerId: document.getElementById('telegramOwnerId').value,
                mustikaApiKey: document.getElementById('mustikaApiKey').value,
                siteName: document.getElementById('siteName').value,
                logoUrl: document.getElementById('logoUrl').value,
                faviconUrl: document.getElementById('faviconUrl').value,
                heroImageUrl: document.getElementById('heroImageUrl').value,
                whatsappNumber1: document.getElementById('whatsappNumber1').value,
                whatsappNumber2: document.getElementById('whatsappNumber2').value,
                whatsappNumber3: document.getElementById('whatsappNumber3').value,
                whatsappNumber4: document.getElementById('whatsappNumber4').value,
                freeGroupLink: document.getElementById('freeGroupLink').value,
                siteDescription: document.getElementById('siteDescription').value
            };

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';
            msg.classList.add('hidden');

            try {
                const res = await fetch('/user/admin/settings', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                
                if (data.success) {
                    msg.innerText = "Pengaturan berhasil disimpan!";
                    msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-green-500/10 text-green-400 border border-green-500/20";
                } else {
                    msg.innerText = data.message || "Gagal menyimpan pengaturan.";
                    msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                }
                msg.classList.remove('hidden');
            } catch (e) {
                msg.innerText = "Server error!";
                msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle"></i> Simpan Pengaturan';
            }
        }

        // --- Chart.js Initialization ---
        function initCharts(orders) {
            if (!orders || orders.length === 0) return;

            // 1. Process for Trend Chart (Last 7 Days)
            const trendData = {};
            for(let i=6; i>=0; i--){
                let d = new Date();
                d.setDate(d.getDate() - i);
                let dateStr = d.toISOString().split('T')[0];
                trendData[dateStr] = 0;
            }

            orders.forEach(o => {
                let d = new Date(o.created_at);
                let dateStr = d.toISOString().split('T')[0];
                if(trendData[dateStr] !== undefined) {
                    trendData[dateStr] += o.price || 0;
                }
            });

            const labels = Object.keys(trendData).map(d => d.substring(5)); // MM-DD
            const dataPoints = Object.values(trendData);

            const ctxOrders = document.getElementById('ordersChart').getContext('2d');
            
            // Create gradient
            let gradient = ctxOrders.createLinearGradient(0, 0, 0, 400);
            gradient.addColorStop(0, 'rgba(168, 85, 247, 0.5)'); // purple-500
            gradient.addColorStop(1, 'rgba(168, 85, 247, 0.0)');

            new Chart(ctxOrders, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Pendapatan (Rp)',
                        data: dataPoints,
                        borderColor: '#a855f7',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#a855f7',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(24, 24, 27, 0.9)',
                            titleColor: '#fff',
                            bodyColor: '#d8b4fe',
                            borderColor: 'rgba(255,255,255,0.1)',
                            borderWidth: 1,
                            padding: 12,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) { label += ': '; }
                                    if (context.parsed.y !== null) {
                                        label += new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(context.parsed.y);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255, 255, 255, 0.05)', drawBorder: false },
                            ticks: { color: '#a1a1aa', font: { family: 'Inter', size: 11 } }
                        },
                        y: {
                            grid: { color: 'rgba(255, 255, 255, 0.05)', drawBorder: false },
                            ticks: { 
                                color: '#a1a1aa', 
                                font: { family: 'Inter', size: 11 },
                                callback: function(value) {
                                    return 'Rp ' + (value/1000) + 'k';
                                }
                            },
                            beginAtZero: true
                        }
                    }
                }
            });

            // 2. Process for Pie Chart (Package Distribution)
            const packageCount = { '1 Bulan': 0, '2 Bulan': 0, 'Lainnya': 0 };
            orders.forEach(o => {
                const pkg = (o.package || '').toLowerCase();
                if(pkg.includes('1 bulan')) packageCount['1 Bulan']++;
                else if(pkg.includes('2 bulan')) packageCount['2 Bulan']++;
                else packageCount['Lainnya']++;
            });

            const ctxPkg = document.getElementById('packageChart').getContext('2d');
            new Chart(ctxPkg, {
                type: 'doughnut',
                data: {
                    labels: ['1 Bulan', '2 Bulan', 'Lainnya'],
                    datasets: [{
                        data: [packageCount['1 Bulan'], packageCount['2 Bulan'], packageCount['Lainnya']],
                        backgroundColor: [
                            '#a855f7', // purple
                            '#3b82f6', // blue
                            '#3f3f46'  // zinc
                        ],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#d4d4d8',
                                padding: 20,
                                font: { family: 'Inter', size: 12 },
                                usePointStyle: true,
                                pointStyle: 'circle'
                            }
                        }
                    }
                }
            });
        }

        <% if (locals.orders) { %>
            document.addEventListener('DOMContentLoaded', function() {
                const ordersData = <%- JSON.stringify(orders) %>;
                initCharts(ordersData);
            });
        <% } %>
    </script>
</body>
</html>