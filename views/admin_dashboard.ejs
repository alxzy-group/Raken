<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Kelola pesanan, grup aktif, voucher, dan identitas website.">
    <title>Admin Dashboard | <%= siteSettings && siteSettings.siteName ? siteSettings.siteName : 'Ravenzena Bot' %></title>
    <link rel="icon" type="image/x-icon" href="<%= siteSettings && siteSettings.faviconUrl ? siteSettings.faviconUrl : '/favicon.ico' %>">
    <link rel="icon" type="image/png" href="<%= siteSettings && siteSettings.faviconUrl ? siteSettings.faviconUrl : '/favicon.png' %>">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
                    colors: {
                        base: '#09090b',
                        surface: 'rgba(24, 24, 27, 0.45)',
                        border: 'rgba(255, 255, 255, 0.08)',
                        accent: '#a855f7', 
                        accentHover: '#9333ea',
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #09090b; color: #f4f4f5; font-family: 'Inter', sans-serif; min-height: 100vh; overflow-x: hidden; }
        
        /* Grid Background Pattern */
        .grid-bg {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            z-index: -2;
            pointer-events: none;
        }

        /* Ambient Glow */
        .ambient-glow {
            position: fixed;
            top: -150px; left: 50%; transform: translateX(-50%);
            width: 800px; height: 400px;
            background: radial-gradient(circle, rgba(168, 85, 247, 0.15) 0%, transparent 60%);
            z-index: -1;
            pointer-events: none;
        }

        /* Glass Cards */
        .glass-card {
            background: rgba(24, 24, 27, 0.6);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
            border-radius: 1rem;
        }

        /* Input Fields */
        .premium-input {
            background: rgba(9, 9, 11, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #f4f4f5;
            transition: all 0.2s ease;
        }
        .premium-input:focus {
            border-color: #a855f7;
            box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.2);
            outline: none;
        }

        /* Nav Item Active State */
        .nav-item {
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .nav-item.active {
            background: rgba(168, 85, 247, 0.15);
            color: #d8b4fe;
            border-right: 3px solid #a855f7;
        }
        .nav-item:hover:not(.active) {
            background: rgba(255, 255, 255, 0.05);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #09090b; }
        ::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #52525b; }

        .fade-in { animation: fadeIn 0.3s ease forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Mobile Nav Active State */
        .nav-item-mobile {
            transition: all 0.2s ease;
        }
        .nav-item-mobile.active {
            color: #d8b4fe;
        }
        .nav-item-mobile.active i {
            color: #a855f7;
            transform: scale(1.1);
        }

        /* Bot Status & Lampu Kedip Indicator */
        .bot-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 11px;
            border-radius: 9999px;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.3px;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            transition: all .2s ease;
        }
        .bot-status-pill.pill-ready {
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #34D399;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.15);
        }
        .bot-status-pill.pill-full {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.35);
            color: #F87171;
            box-shadow: 0 0 10px rgba(239, 68, 68, 0.15);
        }
        .status-lamp {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            position: relative;
        }
        .status-lamp.lamp-ready {
            background-color: #10B981;
            box-shadow: 0 0 8px #10B981;
            animation: blink-lamp-green 1.4s infinite ease-in-out;
        }
        .status-lamp.lamp-full {
            background-color: #EF4444;
            box-shadow: 0 0 8px #EF4444;
            animation: blink-lamp-red 2s infinite ease-in-out;
        }
        @keyframes blink-lamp-green {
            0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.8), 0 0 6px #10B981; opacity: 1; }
            50% { transform: scale(1.15); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0), 0 0 14px #10B981; opacity: 0.85; }
            100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0), 0 0 6px #10B981; opacity: 1; }
        }
        @keyframes blink-lamp-red {
            0%, 100% { transform: scale(1); box-shadow: 0 0 6px #EF4444; opacity: 1; }
            50% { transform: scale(1.1); box-shadow: 0 0 12px #EF4444; opacity: 0.6; }
        }
    </style>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="antialiased selection:bg-purple-500/30">

    <div class="grid-bg"></div>
    <div class="ambient-glow"></div>

    <div class="flex h-screen overflow-hidden">
        
        <!-- Sidebar -->
        <aside class="w-64 flex-shrink-0 border-r border-white/10 glass-card m-4 mr-0 rounded-2xl flex flex-col hidden md:flex overflow-y-auto z-20">
            <div class="p-6 pb-2">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-purple-500/20 flex items-center justify-center border border-purple-500/30">
                        <i class="fas fa-robot text-purple-400 text-lg"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-white tracking-tight">Admin Panel</h1>
                        <p class="text-xs text-zinc-400">Ravenzena Bot</p>
                    </div>
                </div>
            </div>

            <div class="px-4 py-6 flex-1 flex flex-col gap-1">
                <div class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-2 ml-2">Main</div>
                <div class="nav-item active flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-dashboard" onclick="switchTab('section-dashboard')">
                    <i class="fas fa-home w-5 text-center"></i> Dashboard
                </div>
                <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-groups" onclick="switchTab('section-groups')">
                    <i class="fas fa-users w-5 text-center"></i> Grup Aktif
                </div>

                <div class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-2 ml-2 mt-6">Konfigurasi</div>
                <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-slots" onclick="switchTab('section-slots')">
                    <i class="fas fa-server w-5 text-center"></i> Slot & Status Bot
                </div>
                <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-pricing" onclick="switchTab('section-pricing')">
                    <i class="fas fa-tags w-5 text-center"></i> Harga Paket
                </div>
                <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-vouchers" onclick="switchTab('section-vouchers')">
                    <i class="fas fa-ticket-alt w-5 text-center"></i> Voucher Diskon
                </div>
                <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300" data-target="section-settings" onclick="switchTab('section-settings')">
                    <i class="fas fa-cog w-5 text-center"></i> Pengaturan
                </div>
            </div>

            <div class="p-4 border-t border-white/10">
                <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-zinc-300 hover:bg-white/5 transition-colors mb-1">
                    <i class="fas fa-external-link-alt w-5 text-center"></i> Lihat Website
                </a>
                <a href="/user/admin/logout" class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium text-red-400 hover:bg-red-500/10 transition-colors">
                    <i class="fas fa-sign-out-alt w-5 text-center"></i> Logout
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 h-full overflow-y-auto p-4 md:p-8 z-10 scroll-smooth pb-20">
            
            <!-- SECTION: DASHBOARD -->
            <div id="section-dashboard" class="tab-content fade-in">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-3xl font-extrabold text-white tracking-tight">Ringkasan Sistem</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div class="glass-card p-6 flex items-center gap-6">
                        <div class="w-14 h-14 rounded-xl bg-blue-500/20 border border-blue-500/30 flex items-center justify-center text-blue-400 text-2xl">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <div>
                            <p class="text-zinc-400 text-sm font-medium">Total Pesanan</p>
                            <h3 class="text-3xl font-bold text-white"><%= orders.length %></h3>
                        </div>
                    </div>
                    <div class="glass-card p-6 flex items-center gap-6">
                        <div class="w-14 h-14 rounded-xl bg-green-500/20 border border-green-500/30 flex items-center justify-center text-green-400 text-2xl">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <p class="text-zinc-400 text-sm font-medium">Grup Aktif</p>
                            <h3 class="text-3xl font-bold text-white"><%= activeGroups.length %></h3>
                        </div>
                    </div>
                </div>

                <!-- Real-Time Bot Status & Slots Overview -->
                <% 
                   const bStore = (typeof botStatus !== 'undefined' && botStatus.store) ? botStatus.store : { isReady: true, status: 'open', remainingSlots: 20, maxSlots: 20, usedSlots: 0 };
                   const bGuild = (typeof botStatus !== 'undefined' && (botStatus.v3 || botStatus.guild)) ? (botStatus.v3 || botStatus.guild) : { isReady: true, status: 'open', remainingSlots: 15, maxSlots: 15, usedSlots: 0 };
                   const bCc = (typeof botStatus !== 'undefined' && botStatus.cc) ? botStatus.cc : { isReady: true, status: 'open', remainingSlots: 10, maxSlots: 10, usedSlots: 0 };
                %>
                <div class="glass-card p-6 mb-8">
                    <div class="flex items-center justify-between mb-6 border-b border-white/10 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-purple-500/20 border border-purple-500/30 flex items-center justify-center text-purple-400">
                                <i class="fas fa-server text-lg"></i>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white tracking-tight">Ketersediaan & Slot Bot (Realtime)</h3>
                                <p class="text-xs text-zinc-400">Lampu hijau kedip = Ready. Lampu merah = Full Slot / Tutup (Jika nomor bot terkena ban).</p>
                            </div>
                        </div>
                        <button type="button" onclick="switchTab('section-slots')" class="text-xs text-purple-400 hover:text-purple-300 font-semibold flex items-center gap-1.5 transition-colors">
                            Atur Slot Detail <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                        <!-- Bot Store Widget -->
                        <div class="bg-[#121214] border border-white/5 rounded-2xl p-5 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-lg bg-sky-500/20 text-sky-400 flex items-center justify-center text-sm">
                                            <i class="fas fa-store"></i>
                                        </div>
                                        <h4 class="font-bold text-white text-base">Bot Store</h4>
                                    </div>
                                    <span id="overview_badge_store" class="bot-status-pill <%= bStore.isReady ? 'pill-ready' : 'pill-full' %>">
                                        <span class="status-lamp <%= bStore.isReady ? 'lamp-ready' : 'lamp-full' %>"></span>
                                        <span class="status-text"><%= bStore.badgeText || (bStore.isReady ? 'Ready' : 'Full Slot') %></span>
                                    </span>
                                </div>
                                <p class="text-xs text-zinc-400 mb-3">
                                    Kapasitas: <span id="overview_rem_store" class="font-bold text-white"><%= bStore.remainingSlots %></span> / <%= bStore.maxSlots %> slot tersisa
                                </p>
                                <div class="w-full bg-zinc-800 rounded-full h-1.5 mb-4 overflow-hidden">
                                    <% const storePct = bStore.maxSlots > 0 ? Math.min(100, (bStore.usedSlots / bStore.maxSlots) * 100) : 0; %>
                                    <div id="overview_bar_store" class="h-1.5 rounded-full <%= bStore.isReady ? 'bg-sky-500' : 'bg-red-500' %>" style="width: <%= storePct %>%"></div>
                                </div>
                            </div>
                            <button type="button" onclick="toggleBotSlotQuick('store')" id="quick_btn_store" class="w-full py-2 px-3 rounded-lg text-xs font-semibold border transition-all flex items-center justify-center gap-2 <%= bStore.status === 'open' ? 'border-red-500/30 text-red-400 hover:bg-red-500/10' : 'border-green-500/30 text-green-400 hover:bg-green-500/10' %>">
                                <i class="fas <%= bStore.status === 'open' ? 'fa-power-off' : 'fa-play' %>"></i>
                                <span><%= bStore.status === 'open' ? 'Tutup Bot' : 'Buka Bot' %></span>
                            </button>
                        </div>

                        <!-- Bot Guild Widget -->
                        <div class="bg-[#121214] border border-white/5 rounded-2xl p-5 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center text-sm">
                                            <i class="fas fa-users"></i>
                                        </div>
                                        <h4 class="font-bold text-white text-base">Bot Guild</h4>
                                    </div>
                                    <span id="overview_badge_v3" class="bot-status-pill <%= bGuild.isReady ? 'pill-ready' : 'pill-full' %>">
                                        <span class="status-lamp <%= bGuild.isReady ? 'lamp-ready' : 'lamp-full' %>"></span>
                                        <span class="status-text"><%= bGuild.badgeText || (bGuild.isReady ? 'Ready' : 'Full Slot') %></span>
                                    </span>
                                </div>
                                <p class="text-xs text-zinc-400 mb-3">
                                    Kapasitas: <span id="overview_rem_v3" class="font-bold text-white"><%= bGuild.remainingSlots %></span> / <%= bGuild.maxSlots %> slot tersisa
                                </p>
                                <div class="w-full bg-zinc-800 rounded-full h-1.5 mb-4 overflow-hidden">
                                    <% const guildPct = bGuild.maxSlots > 0 ? Math.min(100, (bGuild.usedSlots / bGuild.maxSlots) * 100) : 0; %>
                                    <div id="overview_bar_v3" class="h-1.5 rounded-full <%= bGuild.isReady ? 'bg-purple-500' : 'bg-red-500' %>" style="width: <%= guildPct %>%"></div>
                                </div>
                            </div>
                            <button type="button" onclick="toggleBotSlotQuick('v3')" id="quick_btn_v3" class="w-full py-2 px-3 rounded-lg text-xs font-semibold border transition-all flex items-center justify-center gap-2 <%= bGuild.status === 'open' ? 'border-red-500/30 text-red-400 hover:bg-red-500/10' : 'border-green-500/30 text-green-400 hover:bg-green-500/10' %>">
                                <i class="fas <%= bGuild.status === 'open' ? 'fa-power-off' : 'fa-play' %>"></i>
                                <span><%= bGuild.status === 'open' ? 'Tutup Bot' : 'Buka Bot' %></span>
                            </button>
                        </div>

                        <!-- Bot CC Widget -->
                        <div class="bg-[#121214] border border-white/5 rounded-2xl p-5 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center text-sm">
                                            <i class="fas fa-bolt"></i>
                                        </div>
                                        <h4 class="font-bold text-white text-base">Bot CC</h4>
                                    </div>
                                    <span id="overview_badge_cc" class="bot-status-pill <%= bCc.isReady ? 'pill-ready' : 'pill-full' %>">
                                        <span class="status-lamp <%= bCc.isReady ? 'lamp-ready' : 'lamp-full' %>"></span>
                                        <span class="status-text"><%= bCc.badgeText || (bCc.isReady ? 'Ready' : 'Full Slot') %></span>
                                    </span>
                                </div>
                                <p class="text-xs text-zinc-400 mb-3">
                                    Kapasitas: <span id="overview_rem_cc" class="font-bold text-white"><%= bCc.remainingSlots %></span> / <%= bCc.maxSlots %> slot tersisa
                                </p>
                                <div class="w-full bg-zinc-800 rounded-full h-1.5 mb-4 overflow-hidden">
                                    <% const ccPct = bCc.maxSlots > 0 ? Math.min(100, (bCc.usedSlots / bCc.maxSlots) * 100) : 0; %>
                                    <div id="overview_bar_cc" class="h-1.5 rounded-full <%= bCc.isReady ? 'bg-amber-500' : 'bg-red-500' %>" style="width: <%= ccPct %>%"></div>
                                </div>
                            </div>
                            <button type="button" onclick="toggleBotSlotQuick('cc')" id="quick_btn_cc" class="w-full py-2 px-3 rounded-lg text-xs font-semibold border transition-all flex items-center justify-center gap-2 <%= bCc.status === 'open' ? 'border-red-500/30 text-red-400 hover:bg-red-500/10' : 'border-green-500/30 text-green-400 hover:bg-green-500/10' %>">
                                <i class="fas <%= bCc.status === 'open' ? 'fa-power-off' : 'fa-play' %>"></i>
                                <span><%= bCc.status === 'open' ? 'Tutup Bot' : 'Buka Bot' %></span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Charts Section -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                    <div class="glass-card p-6 lg:col-span-2">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-semibold text-white">Tren Pesanan</h3>
                            <div class="text-xs font-semibold text-purple-400 bg-purple-500/10 px-3 py-1 rounded-full border border-purple-500/20">7 Hari Terakhir</div>
                        </div>
                        <div class="relative h-64 w-full">
                            <canvas id="ordersChart"></canvas>
                        </div>
                    </div>
                    <div class="glass-card p-6 lg:col-span-1">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-semibold text-white">Distribusi Paket</h3>
                        </div>
                        <div class="relative h-64 w-full flex items-center justify-center">
                            <canvas id="packageChart"></canvas>
                        </div>
                    </div>
                </div>

                <div class="glass-card overflow-hidden">
                    <div class="p-6 border-b border-white/10 flex items-center gap-3">
                        <i class="fas fa-list text-purple-400"></i>
                        <h3 class="text-lg font-semibold text-white">Pesanan Terakhir</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-zinc-300">
                            <thead class="bg-white/5 text-zinc-400 font-medium">
                                <tr>
                                    <th class="px-6 py-4">ID Order</th>
                                    <th class="px-6 py-4">Status</th>
                                    <th class="px-6 py-4">Bot</th>
                                    <th class="px-6 py-4">Paket</th>
                                    <th class="px-6 py-4">Harga</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5">
                                <% if(orders.length === 0) { %>
                                    <tr><td colspan="5" class="px-6 py-12 text-center text-zinc-500">Belum ada pesanan masuk.</td></tr>
                                <% } else { %>
                                    <% orders.slice(0, 10).forEach(order => { %>
                                    <tr class="hover:bg-white/5 transition-colors">
                                        <td class="px-6 py-4 font-mono text-purple-400"><%= order.id %></td>
                                        <td class="px-6 py-4">
                                            <% if(order.status === 'PAID') { %>
                                                <span class="px-2.5 py-1 bg-green-500/20 text-green-400 border border-green-500/30 rounded-full text-xs font-bold">LUNAS</span>
                                            <% } else if(order.status === 'COMPLETED') { %>
                                                <span class="px-2.5 py-1 bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded-full text-xs font-bold">SELESAI</span>
                                            <% } else if(order.status === 'WAITING') { %>
                                                <span class="px-2.5 py-1 bg-purple-500/20 text-purple-400 border border-purple-500/30 rounded-full text-xs font-bold">MENUNGGU BOT</span>
                                            <% } else if(order.status === 'CANCELLED' || order.status === 'ERROR') { %>
                                                <span class="px-2.5 py-1 bg-red-500/20 text-red-400 border border-red-500/30 rounded-full text-xs font-bold"><%= order.status %></span>
                                            <% } else { %>
                                                <span class="px-2.5 py-1 bg-yellow-500/20 text-yellow-400 border border-yellow-500/30 rounded-full text-xs font-bold">PENDING</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 uppercase font-semibold"><%= order.jenis_bot %></td>
                                        <td class="px-6 py-4"><%= order.paket %> (<%= order.tipe_order %>)</td>
                                        <td class="px-6 py-4 font-semibold text-white">Rp <%= order.harga.toLocaleString('id-ID') %></td>
                                    </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

