                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-white/5">
                                            <% if(vouchers.length === 0) { %>
                                                <tr><td colspan="5" class="px-6 py-12 text-center text-zinc-500">Belum ada voucher aktif.</td></tr>
                                            <% } else { %>
                                                <% vouchers.forEach(v => { %>
                                                <tr class="hover:bg-white/5 transition-colors">
                                                    <td class="px-6 py-4 font-mono font-bold text-purple-400"><%= v.code %></td>
                                                    <td class="px-6 py-4"><span class="px-2 py-1 bg-white/10 rounded text-xs uppercase"><%= v.jenisBot %></span></td>
                                                    <td class="px-6 py-4 font-semibold text-white"><%= v.discount %>%</td>
                                                    <td class="px-6 py-4"><%= v.usedCount %> / <%= v.maxUsage === 0 ? '∞' : v.maxUsage %></td>
                                                    <td class="px-6 py-4 text-right">
                                                        <button onclick="deleteVoucher('<%= v.id %>')" class="text-red-400 hover:text-red-300 p-2 bg-red-500/10 hover:bg-red-500/20 rounded-lg transition-colors">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION: SETTINGS -->
            <div id="section-settings" class="tab-content hidden">
                <div class="max-w-4xl">
                    <h2 class="text-3xl font-extrabold text-white tracking-tight mb-2">Pengaturan Sistem</h2>
                    <p class="text-zinc-400 mb-8">Konfigurasikan integrasi pihak ketiga dan identitas visual website.</p>

                    <form id="settingsForm" onsubmit="saveSettings(event)">
                        <div class="glass-card p-8 mb-6">
                            <h3 class="text-xl font-semibold text-white mb-6 border-b border-white/10 pb-4 flex items-center gap-3">
                                <i class="fas fa-plug text-purple-400"></i> Integrasi API
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">AustinPay API Key</label>
                                    <input type="text" id="austinApiKey" value="<%= austinApiKey || '' %>" class="premium-input w-full rounded-lg px-4 py-3 font-mono">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">AustinPay API Secret</label>
                                    <input type="text" id="austinApiSecret" value="<%= austinApiSecret || '' %>" class="premium-input w-full rounded-lg px-4 py-3 font-mono">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Telegram Bot Token</label>
                                    <input type="text" id="telegramBotToken" value="<%= telegramBotToken || '' %>" class="premium-input w-full rounded-lg px-4 py-3 font-mono">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Telegram Owner ID</label>
                                    <input type="text" id="telegramOwnerId" value="<%= telegramOwnerId || '' %>" class="premium-input w-full rounded-lg px-4 py-3 font-mono">
                                </div>
                            </div>
                        </div>

                        <div class="glass-card p-8 mb-6">
                            <h3 class="text-xl font-semibold text-white mb-6 border-b border-white/10 pb-4 flex items-center gap-3">
                                <i class="fas fa-paint-brush text-purple-400"></i> Identitas Website
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Nama Website</label>
                                    <input type="text" id="siteName" value="<%= siteSettings && siteSettings.siteName ? siteSettings.siteName : '' %>" class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">URL Logo</label>
                                    <div class="flex gap-2">
                                        <input type="text" id="logoUrl" value="<%= siteSettings && siteSettings.logoUrl ? siteSettings.logoUrl : '' %>" class="premium-input w-full rounded-lg px-4 py-3">
                                        <label class="bg-purple-500/20 text-purple-400 border border-purple-500/30 rounded-lg px-4 flex items-center justify-center cursor-pointer hover:bg-purple-500/30 transition-all" title="Upload Logo">
                                            <i class="fas fa-upload"></i>
                                            <input type="file" accept="image/png, image/jpeg, image/jpg, image/webp" class="hidden" onchange="uploadImage(this, 'logoUrl', false)">
                                        </label>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">URL Favicon</label>
                                    <div class="flex gap-2">
                                        <input type="text" id="faviconUrl" value="<%= siteSettings && siteSettings.faviconUrl ? siteSettings.faviconUrl : '' %>" placeholder="/favicon.png" class="premium-input w-full rounded-lg px-4 py-3">
                                        <label class="bg-purple-500/20 text-purple-400 border border-purple-500/30 rounded-lg px-4 flex items-center justify-center cursor-pointer hover:bg-purple-500/30 transition-all" title="Upload Favicon (Auto convert to ICO)">
                                            <i class="fas fa-upload"></i>
                                            <input type="file" accept="image/png, image/jpeg, image/jpg, image/webp" class="hidden" onchange="uploadImage(this, 'faviconUrl', true)">
                                        </label>
                                    </div>
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">URL Gambar Hero (Thumbnail)</label>
                                    <div class="flex gap-2">
                                        <input type="text" id="heroImageUrl" value="<%= siteSettings && siteSettings.heroImageUrl ? siteSettings.heroImageUrl : '' %>" class="premium-input w-full rounded-lg px-4 py-3">
                                        <label class="bg-purple-500/20 text-purple-400 border border-purple-500/30 rounded-lg px-4 flex items-center justify-center cursor-pointer hover:bg-purple-500/30 transition-all" title="Upload Gambar Hero">
                                            <i class="fas fa-upload"></i>
                                            <input type="file" accept="image/png, image/jpeg, image/jpg, image/webp" class="hidden" onchange="uploadImage(this, 'heroImageUrl', false)">
                                        </label>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Nomor WhatsApp 1</label>
                                    <input type="text" id="whatsappNumber1" value="<%= siteSettings && siteSettings.whatsappNumber1 ? siteSettings.whatsappNumber1 : '' %>" placeholder="628..." class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Nomor WhatsApp 2 (Opsional)</label>
                                    <input type="text" id="whatsappNumber2" value="<%= siteSettings && siteSettings.whatsappNumber2 ? siteSettings.whatsappNumber2 : '' %>" placeholder="628..." class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Nomor WhatsApp 3 (Opsional)</label>
                                    <input type="text" id="whatsappNumber3" value="<%= siteSettings && siteSettings.whatsappNumber3 ? siteSettings.whatsappNumber3 : '' %>" placeholder="628..." class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Nomor WhatsApp 4 (Opsional)</label>
                                    <input type="text" id="whatsappNumber4" value="<%= siteSettings && siteSettings.whatsappNumber4 ? siteSettings.whatsappNumber4 : '' %>" placeholder="628..." class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Link Grup Gratis</label>
                                    <input type="url" id="freeGroupLink" value="<%= siteSettings && siteSettings.freeGroupLink ? siteSettings.freeGroupLink : '' %>" placeholder="https://chat.whatsapp.com/..." class="premium-input w-full rounded-lg px-4 py-3">
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-2">Deskripsi Website</label>
                                    <textarea id="siteDescription" rows="3" class="premium-input w-full rounded-lg px-4 py-3"><%= siteSettings && siteSettings.siteDescription ? siteSettings.siteDescription : '' %></textarea>
                                </div>
                            </div>
                        </div>

                        <div id="settingsMessage" class="hidden px-4 py-3 rounded-lg text-sm font-medium mb-6"></div>
                        
                        <button type="submit" id="settingsSubmit" class="bg-purple-500 hover:bg-purple-600 text-white px-8 py-3.5 rounded-xl font-semibold shadow-lg shadow-purple-500/25 transition-all flex items-center gap-2">
                            <i class="fas fa-check-circle"></i> Simpan Pengaturan
                        </button>
                    </form>
                </div>
            </div>

        </main>
    </div>

    <!-- Mobile Bottom Nav -->
    <div class="md:hidden fixed bottom-0 w-full bg-[#09090b]/90 backdrop-blur-xl border-t border-white/10 z-50 flex justify-around p-2 pb-4">
        <div class="nav-item-mobile active flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-dashboard" onclick="switchTab('section-dashboard')">
            <i class="fas fa-home text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Home</span>
        </div>
        <div class="nav-item-mobile flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-groups" onclick="switchTab('section-groups')">
            <i class="fas fa-users text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Grup</span>
        </div>
        <div class="nav-item-mobile flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-slots" onclick="switchTab('section-slots')">
            <i class="fas fa-server text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Slot</span>
        </div>
        <div class="nav-item-mobile flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-pricing" onclick="switchTab('section-pricing')">
            <i class="fas fa-tags text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Harga</span>
        </div>
        <div class="nav-item-mobile flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-vouchers" onclick="switchTab('section-vouchers')">
            <i class="fas fa-ticket-alt text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Voucher</span>
        </div>
        <div class="nav-item-mobile flex flex-col items-center gap-1 p-2 text-zinc-500 cursor-pointer" data-target="section-settings" onclick="switchTab('section-settings')">
            <i class="fas fa-cog text-xl transition-all"></i>
            <span class="text-[10px] font-semibold">Setelan</span>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        // Tab Navigation Logic
        function switchTab(targetId) {
            // Update nav items
            document.querySelectorAll('.nav-item').forEach(el => {
                if(el.dataset.target === targetId) {
                    el.classList.add('active');
                } else {
                    el.classList.remove('active');
                }
            });

            // Update mobile nav items
            document.querySelectorAll('.nav-item-mobile').forEach(el => {
                if(el.dataset.target === targetId) {
                    el.classList.add('active');
                    el.classList.replace('text-zinc-500', 'text-purple-400');
                } else {
                    el.classList.remove('active');
                    el.classList.replace('text-purple-400', 'text-zinc-500');
                }
            });

            // Update content sections
            document.querySelectorAll('.tab-content').forEach(el => {
                if(el.id === targetId) {
                    el.classList.remove('hidden');
                    el.classList.add('fade-in');
                } else {
                    el.classList.add('hidden');
                    el.classList.remove('fade-in');
                }
            });

            // Trigger specific load actions per tab
            if(targetId === 'section-pricing') {
                loadPricingConfig();
            } else if(targetId === 'section-slots') {
                loadSlotsConfig();
            }
        }

        // PRICING LOGIC
        async function loadPricingConfig() {
            const textarea = document.getElementById('pricingJsonInput');
            try {
                textarea.value = "Memuat data dari database...";
                const res = await fetch('/user/admin/pricing');
                const data = await res.json();
                if (data.success && data.data) {
                    textarea.value = JSON.stringify(data.data, null, 4);
                } else {
                    textarea.value = "Gagal memuat harga. Gunakan config.js default.";
                }
            } catch (err) {
                console.error(err);
                textarea.value = "Koneksi ke server gagal.";
            }
        }

        async function savePricingConfig(e) {
            e.preventDefault();
            const btn = document.getElementById('pricingSubmit');
            const msg = document.getElementById('pricingMessage');
            const val = document.getElementById('pricingJsonInput').value;
            
            let parsed = null;
            try {
                parsed = JSON.parse(val);
            } catch (err) {
                msg.innerText = "Format JSON salah! Perhatikan tanda kutip dan kurung kurawal.";
                msg.className = "mt-4 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';
            msg.classList.add('hidden');

            try {
                const res = await fetch('/user/admin/pricing', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ pricing: parsed })
                });
                const data = await res.json();
                if(data.success) {
                    msg.innerText = "Harga berhasil disimpan dan langsung aktif!";
                    msg.className = "mt-4 px-4 py-3 rounded-lg text-sm font-medium bg-green-500/10 text-green-400 border border-green-500/20";
                } else {
                    msg.innerText = data.message || "Gagal menyimpan.";
                    msg.className = "mt-4 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                }
                msg.classList.remove('hidden');
            } catch (err) {
                msg.innerText = "Terjadi kesalahan koneksi saat menyimpan.";
                msg.className = "mt-4 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save"></i> Simpan Harga';
            }
        }

        // VOUCHER LOGIC
        async function createVoucher(e) {
            e.preventDefault();
            const btn = document.getElementById('voucherSubmit');
            const msg = document.getElementById('voucherMessage');
            
            const payload = {
                code: document.getElementById('voucherCode').value,
                discount: document.getElementById('voucherDiscount').value,
                maxUsage: document.getElementById('voucherMax').value,
                jenisBot: document.getElementById('voucherBot').value,
                expiry: ''
            };

            btn.disabled = true;
            btn.innerText = 'Membuat...';
            msg.classList.add('hidden');

            try {
                const res = await fetch('/user/admin/vouchers', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    msg.innerText = data.message;
                    msg.className = "mt-4 px-4 py-2 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                    msg.classList.remove('hidden');
                    btn.disabled = false;
                    btn.innerText = 'Buat Voucher';
                }
            } catch (err) {
                msg.innerText = "Server Error";
                msg.className = "mt-4 px-4 py-2 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
                btn.disabled = false;
                btn.innerText = 'Buat Voucher';
            }
        }

        async function deleteVoucher(id) {
            if(!confirm('Hapus voucher ini secara permanen?')) return;
            try {
                await fetch('/user/admin/vouchers/' + id, { method: 'DELETE' });
                window.location.reload();
            } catch (e) {
                alert('Gagal menghapus voucher');
            }
        }

        // SETTINGS LOGIC
        async function uploadImage(input, targetId, convertToIco) {
            if(!input.files || input.files.length === 0) return;
            const file = input.files[0];
            const msg = document.getElementById('settingsMessage');
            const targetInput = document.getElementById(targetId);
            
            const formData = new FormData();
            formData.append('file', file);
            if (convertToIco) formData.append('convertToIco', 'true');

            const originalValue = targetInput.value;
            targetInput.value = 'Mengupload...';
            
            try {
                const res = await fetch('/user/admin/upload', {
                    method: 'POST',
                    body: formData
                });
                
                let data;
                const text = await res.text();
                try {
                    data = JSON.parse(text);
                } catch(e) {
                    throw new Error(`Server Response Error (HTTP ${res.status}): ` + text.substring(0, 100));
                }
                
                if(data.success) {
                    targetInput.value = data.url;
                    msg.innerText = "Gambar berhasil diupload!";
                    msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-green-500/10 text-green-400 border border-green-500/20";
                    msg.classList.remove('hidden');
                } else {
                    targetInput.value = originalValue;
                    msg.innerText = data.message || "Gagal mengupload.";
                    msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                    msg.classList.remove('hidden');
                }
            } catch(err) {
                console.error(err);
                targetInput.value = originalValue;
                msg.innerText = err.message || "Koneksi terputus saat upload.";
                msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
            }
            
            // Clear file input so same file can be uploaded again if needed
            input.value = '';
        }

        async function saveSettings(e) {
            e.preventDefault();
            const btn = document.getElementById('settingsSubmit');
            const msg = document.getElementById('settingsMessage');
            
            const payload = {
                telegramBotToken: document.getElementById('telegramBotToken').value,
                telegramOwnerId: document.getElementById('telegramOwnerId').value,
                austinApiKey: document.getElementById('austinApiKey').value,
                austinApiSecret: document.getElementById('austinApiSecret').value,
                siteName: document.getElementById('siteName').value,
                logoUrl: document.getElementById('logoUrl').value,
                faviconUrl: document.getElementById('faviconUrl').value,
                heroImageUrl: document.getElementById('heroImageUrl').value,
                whatsappNumber1: document.getElementById('whatsappNumber1').value,
                whatsappNumber2: document.getElementById('whatsappNumber2').value,
                whatsappNumber3: document.getElementById('whatsappNumber3').value,
                whatsappNumber4: document.getElementById('whatsappNumber4').value,
                freeGroupLink: document.getElementById('freeGroupLink').value,
                siteDescription: document.getElementById('siteDescription').value
            };

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';
            msg.classList.add('hidden');

            try {
                const res = await fetch('/user/admin/settings', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                
                if (data.success) {
                    msg.innerText = "Pengaturan berhasil disimpan!";
                    msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-green-500/10 text-green-400 border border-green-500/20";
                } else {
                    msg.innerText = data.message || "Gagal menyimpan pengaturan.";
                    msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                }
                msg.classList.remove('hidden');
            } catch (e) {
                msg.innerText = "Server error!";
                msg.className = "mb-6 px-4 py-3 rounded-lg text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle"></i> Simpan Pengaturan';
            }
        }

        // --- Chart.js Initialization ---
        function initCharts(orders) {
            if (!orders || orders.length === 0) return;

            // 1. Process for Trend Chart (Last 7 Days)
            const trendData = {};
            for(let i=6; i>=0; i--){
                let d = new Date();
                d.setDate(d.getDate() - i);
                let dateStr = d.toISOString().split('T')[0];
                trendData[dateStr] = 0;
            }

            orders.forEach(o => {
                let d = new Date(o.created_at);
                let dateStr = d.toISOString().split('T')[0];
                if(trendData[dateStr] !== undefined) {
                    trendData[dateStr] += o.price || 0;
                }
            });

            const labels = Object.keys(trendData).map(d => d.substring(5)); // MM-DD
            const dataPoints = Object.values(trendData);

            const ctxOrders = document.getElementById('ordersChart').getContext('2d');
            
            // Create gradient
            let gradient = ctxOrders.createLinearGradient(0, 0, 0, 400);
            gradient.addColorStop(0, 'rgba(168, 85, 247, 0.5)'); // purple-500
            gradient.addColorStop(1, 'rgba(168, 85, 247, 0.0)');

            new Chart(ctxOrders, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Pendapatan (Rp)',
                        data: dataPoints,
                        borderColor: '#a855f7',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#a855f7',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(24, 24, 27, 0.9)',
                            titleColor: '#fff',
                            bodyColor: '#d8b4fe',
                            borderColor: 'rgba(255,255,255,0.1)',
                            borderWidth: 1,
                            padding: 12,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) { label += ': '; }
                                    if (context.parsed.y !== null) {
                                        label += new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(context.parsed.y);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255, 255, 255, 0.05)', drawBorder: false },
                            ticks: { color: '#a1a1aa', font: { family: 'Inter', size: 11 } }
                        },
                        y: {
                            grid: { color: 'rgba(255, 255, 255, 0.05)', drawBorder: false },
                            ticks: { 
                                color: '#a1a1aa', 
                                font: { family: 'Inter', size: 11 },
                                callback: function(value) {
                                    return 'Rp ' + (value/1000) + 'k';
                                }
                            },
                            beginAtZero: true
                        }
                    }
                }
            });

            // 2. Process for Pie Chart (Package Distribution)
            const packageCount = { '1 Bulan': 0, '2 Bulan': 0, 'Lainnya': 0 };
            orders.forEach(o => {
                const pkg = (o.package || '').toLowerCase();
                if(pkg.includes('1 bulan')) packageCount['1 Bulan']++;
                else if(pkg.includes('2 bulan')) packageCount['2 Bulan']++;
                else packageCount['Lainnya']++;
            });

            const ctxPkg = document.getElementById('packageChart').getContext('2d');
            new Chart(ctxPkg, {
                type: 'doughnut',
                data: {
                    labels: ['1 Bulan', '2 Bulan', 'Lainnya'],
                    datasets: [{
                        data: [packageCount['1 Bulan'], packageCount['2 Bulan'], packageCount['Lainnya']],
                        backgroundColor: [
                            '#a855f7', // purple
                            '#3b82f6', // blue
                            '#3f3f46'  // zinc
                        ],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#d4d4d8',
                                padding: 20,
                                font: { family: 'Inter', size: 12 },
                                usePointStyle: true,
                                pointStyle: 'circle'
                            }
                        }
                    }
                }
            });
        }

                // Initialize Charts on Load
            <% if(typeof orders !== 'undefined') { %>
            document.addEventListener('DOMContentLoaded', function() {
                const ordersData = <%- JSON.stringify(orders) %>;
                initCharts(ordersData);
            });
            <% } %>

            // Countdown Logic for Active Groups
            function updateCountdowns() {
                const timers = document.querySelectorAll('.countdown-timer');
                const now = new Date().getTime();
                timers.forEach(timer => {
                    const expireStr = timer.getAttribute('data-expire');
                    if (!expireStr || expireStr === 'undefined' || expireStr === 'null') {
                        timer.innerText = "Unlimited";
                        return;
                    }
                    
                    const lowerStr = expireStr.toLowerCase().trim();
                    if (lowerStr === 'permanent' || lowerStr === 'unlimited' || lowerStr === '0' || lowerStr === '-1') {
                        timer.innerText = "Permanent";
                        return;
                    }
                    
                    let expireTime;
                    // If it's a numeric timestamp string
                    if (!isNaN(expireStr) && String(expireStr).trim() !== '') {
                        expireTime = parseInt(expireStr);
                        if (expireTime < 10000000000) expireTime *= 1000;
                    } else {
                        // Otherwise try to parse as ISO date string
                        expireTime = new Date(expireStr).getTime();
                    }
                    
                    if (isNaN(expireTime)) {
                        timer.innerText = "Invalid Date";
                        timer.classList.remove('text-blue-400', 'bg-blue-500/10', 'border-blue-500/20');
                        timer.classList.add('text-red-400', 'bg-red-500/10', 'border-red-500/20');
                        return;
                    }
                    
                    const distance = expireTime - now;
                    if (distance < 0) {
                        timer.innerText = "EXPIRED";
                        timer.classList.remove('text-blue-400', 'bg-blue-500/10', 'border-blue-500/20');
                        timer.classList.add('text-red-400', 'bg-red-500/10', 'border-red-500/20');
                    } else {
                        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                        const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                        timer.innerText = `Masa aktif ${days}h ${hours}j ${minutes}m ${seconds}d`;
                    }
                });
            }
            setInterval(updateCountdowns, 1000);
            updateCountdowns();

        // ==========================================
        // BOT SLOTS REALTIME MANAGEMENT LOGIC
        // ==========================================
        let liveBotSlotsData = null;

        async function loadSlotsConfig() {
            try {
                const res = await fetch('/user/admin/slots');
                const data = await res.json();
                if (data.success && data.data) {
                    liveBotSlotsData = data.data;
                    applySlotsDataToUI(data.data);
                }
            } catch (err) {
                console.error('Failed to load slots config:', err);
            }
        }

        function applySlotsDataToUI(data) {
            const cfg = data.config || {};
            const st = data.status || {};

            ['store', 'v3', 'cc'].forEach(botId => {
                const bCfg = cfg[botId] || {};
                const bSt = st[botId] || {};

                const statusEl = document.getElementById(`slot_${botId}_status`);
                const maxEl = document.getElementById(`slot_${botId}_max`);
                const modeEl = document.getElementById(`slot_${botId}_mode`);
                const usedEl = document.getElementById(`slot_${botId}_used`);

                if (statusEl && bCfg.status) statusEl.value = bCfg.status;
                if (maxEl && bCfg.maxSlots !== undefined) maxEl.value = bCfg.maxSlots;
                if (modeEl && bCfg.mode) modeEl.value = bCfg.mode;
                if (usedEl && bCfg.usedSlots !== undefined) usedEl.value = bCfg.usedSlots;

                updateSlotPreview(botId, bSt.activeDbGroups);
            });
        }

        function updateSlotPreview(botId, explicitDbCount) {
            const statusEl = document.getElementById(`slot_${botId}_status`);
            const maxEl = document.getElementById(`slot_${botId}_max`);
            const modeEl = document.getElementById(`slot_${botId}_mode`);
            const usedEl = document.getElementById(`slot_${botId}_used`);
            const badgeEl = document.getElementById(`slot_badge_${botId}`);

            if (!statusEl || !maxEl || !modeEl || !usedEl || !badgeEl) return;

            const status = statusEl.value;
            const max = Math.max(0, parseInt(maxEl.value) || 0);
            const mode = modeEl.value;
            const manualUsed = Math.max(0, parseInt(usedEl.value) || 0);
            
            let dbCount = 0;
            if (explicitDbCount !== undefined) {
                dbCount = explicitDbCount;
            } else if (liveBotSlotsData && liveBotSlotsData.status && liveBotSlotsData.status[botId]) {
                dbCount = liveBotSlotsData.status[botId].activeDbGroups || 0;
            }

            let totalUsed = mode === 'manual' ? manualUsed : (dbCount + manualUsed);
            let remaining = Math.max(0, max - totalUsed);
            let isReady = (status === 'open') && (max <= 0 ? true : remaining > 0);
            let badgeText = isReady ? 'Ready' : 'Full Slot';

            // Update badge in section-slots
            badgeEl.className = `bot-status-pill ${isReady ? 'pill-ready' : 'pill-full'}`;
            badgeEl.innerHTML = `<span class="status-lamp ${isReady ? 'lamp-ready' : 'lamp-full'}"></span><span class="status-text">${badgeText}</span>`;

            // Update info text
            const dbInfoEl = document.getElementById(`slot_${botId}_db_info`);
            const usedInfoEl = document.getElementById(`slot_${botId}_used_info`);
            const remInfoEl = document.getElementById(`slot_${botId}_rem_info`);
            if (dbInfoEl) dbInfoEl.innerText = `${dbCount} grup`;
            if (usedInfoEl) usedInfoEl.innerText = totalUsed;
            if (remInfoEl) {
                remInfoEl.innerText = `${remaining} slot`;
                remInfoEl.className = `font-mono ${remaining > 0 ? 'text-green-400' : 'text-red-400'}`;
            }

            // Update overview card if present
            const ovBadge = document.getElementById(`overview_badge_${botId}`);
            const ovRem = document.getElementById(`overview_rem_${botId}`);
            const ovBar = document.getElementById(`overview_bar_${botId}`);
            const qBtn = document.getElementById(`quick_btn_${botId}`);

            if (ovBadge) {
                ovBadge.className = `bot-status-pill ${isReady ? 'pill-ready' : 'pill-full'}`;
                ovBadge.innerHTML = `<span class="status-lamp ${isReady ? 'lamp-ready' : 'lamp-full'}"></span><span class="status-text">${badgeText}</span>`;
            }
            if (ovRem) ovRem.innerText = remaining;
            if (ovBar) {
                const pct = max > 0 ? Math.min(100, (totalUsed / max) * 100) : 0;
                ovBar.style.width = `${pct}%`;
                ovBar.className = `h-1.5 rounded-full ${isReady ? 'bg-sky-500' : 'bg-red-500'}`;
            }
            if (qBtn) {
                const isOpen = status === 'open';
                qBtn.className = `w-full py-2 px-3 rounded-lg text-xs font-semibold border transition-all flex items-center justify-center gap-2 ${isOpen ? 'border-red-500/30 text-red-400 hover:bg-red-500/10' : 'border-green-500/30 text-green-400 hover:bg-green-500/10'}`;
                qBtn.innerHTML = `<i class="fas ${isOpen ? 'fa-power-off' : 'fa-play'}"></i><span>${isOpen ? 'Tutup Bot' : 'Buka Bot'}</span>`;
            }
        }

        async function saveBotSlots(e) {
            e.preventDefault();
            const btn = document.getElementById('slotsSubmit');
            const msg = document.getElementById('slotsMessage');

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';
            msg.classList.add('hidden');

            const payload = {
                slots: {
                    store: {
                        status: document.getElementById('slot_store_status').value,
                        maxSlots: document.getElementById('slot_store_max').value,
                        mode: document.getElementById('slot_store_mode').value,
                        usedSlots: document.getElementById('slot_store_used').value
                    },
                    v3: {
                        status: document.getElementById('slot_v3_status').value,
                        maxSlots: document.getElementById('slot_v3_max').value,
                        mode: document.getElementById('slot_v3_mode').value,
                        usedSlots: document.getElementById('slot_v3_used').value
                    },
                    cc: {
                        status: document.getElementById('slot_cc_status').value,
                        maxSlots: document.getElementById('slot_cc_max').value,
                        mode: document.getElementById('slot_cc_mode').value,
                        usedSlots: document.getElementById('slot_cc_used').value
                    }
                }
            };

            try {
                const res = await fetch('/user/admin/slots', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    liveBotSlotsData = data.data;
                    applySlotsDataToUI(data.data);
                    msg.innerText = data.message || "Pengaturan slot bot berhasil disimpan dan langsung aktif!";
                    msg.className = "px-4 py-3 rounded-lg text-sm font-medium mb-6 bg-green-500/10 text-green-400 border border-green-500/20";
                } else {
                    msg.innerText = data.message || "Gagal menyimpan slot.";
                    msg.className = "px-4 py-3 rounded-lg text-sm font-medium mb-6 bg-red-500/10 text-red-400 border border-red-500/20";
                }
                msg.classList.remove('hidden');
            } catch (err) {
                msg.innerText = "Terjadi kesalahan koneksi saat menyimpan.";
                msg.className = "px-4 py-3 rounded-lg text-sm font-medium mb-6 bg-red-500/10 text-red-400 border border-red-500/20";
                msg.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save"></i> Simpan Semua Pengaturan Slot';
            }
        }

        async function toggleBotSlotQuick(botId) {
            const btn = document.getElementById(`quick_btn_${botId}`);
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...';
            }

            try {
                const res = await fetch('/user/admin/slots/toggle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ botId })
                });
                const data = await res.json();
                if (data.success && data.data) {
                    liveBotSlotsData = data.data;
                    applySlotsDataToUI(data.data);
                } else {
                    alert(data.message || 'Gagal mengubah status bot.');
                }
            } catch (err) {
                alert('Terjadi kesalahan jaringan.');
            } finally {
                if (btn) btn.disabled = false;
            }
        }
    </script>
</body>
</html>