<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <script>
        try {
            if (localStorage.getItem('theme') === 'light') {
                document.documentElement.classList.remove('dark');
                document.documentElement.classList.add('light-theme');
            }
        } catch(e) {}
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Ravenzena Bot</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
                    colors: { base: '#050505', surface: '#111111', border: '#262626', accent: '#3B82F6', success: '#10B981', warning: '#F59E0B', danger: '#EF4444' }
                }
            }
        }
    </script>
    <style>
        body { background-color: #050505; color: #E5E7EB; }
        .grid-lines { background-image: linear-gradient(to right, #111111 1px, transparent 1px), linear-gradient(to bottom, #111111 1px, transparent 1px); background-size: 40px 40px; }
        .order-card { background: #0A0A0A; border: 1px solid #262626; transition: border-color 0.2s; }
        .order-card:hover { border-color: #3B82F6; }
        
        /* MAGIC LIGHT MODE */
        html.light-theme {
            filter: invert(1) hue-rotate(180deg);
            background-color: #FAFAFA;
        }
        html.light-theme img, 
        html.light-theme .re-invert {
            filter: invert(1) hue-rotate(180deg); 
        }
        html.light-theme .text-danger.re-invert {
            color: #DC2626 !important;
            font-weight: 900 !important;
        }
        html.light-theme .text-warning.re-invert {
            color: #D97706 !important;
            font-weight: 900 !important;
        }
        html.light-theme ::-webkit-scrollbar-track { background: #FAFAFA; }
        html.light-theme ::-webkit-scrollbar-thumb { background: #D9D9D9; }
    </style>
</head>
<body class="antialiased min-h-screen">
    <div class="fixed inset-0 grid-lines z-0 opacity-20"></div>
    
    <nav class="sticky top-0 w-full z-50 border-b border-border bg-base/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <img src="/favicon.png" alt="Logo" class="w-8 h-8 rounded-lg">
                <span class="font-bold text-lg text-white">Admin Dashboard</span>
            </div>
            <div class="flex items-center gap-2">
                <!-- Theme Toggle Button -->
                <button onclick="toggleTheme()" class="text-gray-400 hover:text-white focus:outline-none flex items-center justify-center p-2 rounded-lg bg-surface/50 border border-border re-invert">
                    <svg class="w-6 h-6 text-accent theme-icon-sun" style="display:none;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    <svg class="w-6 h-6 theme-icon-moon" style="display:block;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </button>
                <!-- Hamburger Button -->
                <button id="mobile-menu-btn" onclick="toggleMobileMenu(true)" class="text-gray-400 hover:text-white focus:outline-none flex items-center justify-center p-2 rounded-lg bg-surface/50 border border-border">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>
    </nav>

    <main class="relative z-10 max-w-7xl mx-auto px-6 py-12">
        <div class="flex items-center justify-between mb-10">
            <div>
                <h1 class="text-3xl font-bold text-white mb-2">Admin Panel</h1>
                <p class="text-gray-400 text-sm">Kelola pesanan dan pantau grup aktif secara real-time.</p>
                
                <!-- Active Tab Badge -->
                <div class="mt-3 inline-flex items-center gap-2 px-3.5 py-1.5 bg-accent/15 text-accent border border-accent/20 rounded-full text-[10px] font-black uppercase tracking-wider">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
                    <span id="mobile-active-tab-title">Sewa Baru</span>
                </div>
            </div>
            <div class="flex gap-4">
                <div class="bg-surface border border-border px-4 py-2 rounded-xl text-sm">
                    Orders: <span class="text-accent font-bold"><%= orders.length %></span>
                </div>
                <div class="bg-surface border border-border px-4 py-2 rounded-xl text-sm">
                    Groups: <span class="text-success font-bold"><%= activeGroups.length %></span>
                </div>
            </div>
        </div>

        <!-- Filter & Tabs -->
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-8 bg-surface/50 p-4 rounded-2xl border border-border">
            <div class="hidden bg-base p-1 rounded-xl border border-border w-full md:w-auto">
                <button onclick="switchTab('baru')" id="btn-baru" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-lg text-sm font-semibold transition-all bg-accent text-white">Sewa Baru</button>
                <button onclick="switchTab('perpanjang')" id="btn-perpanjang" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-lg text-sm font-semibold transition-all text-gray-400 hover:text-white">Perpanjang</button>
                <button onclick="switchTab('aktif')" id="btn-aktif" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-lg text-sm font-semibold transition-all text-gray-400 hover:text-white">Semua Grup</button>
                <button onclick="switchTab('settings')" id="btn-settings" class="tab-btn flex-1 md:flex-none px-6 py-2.5 rounded-lg text-sm font-semibold transition-all text-gray-400 hover:text-white">Settings</button>
            </div>
            
            <div class="flex items-center gap-3 w-full md:w-auto">
                <span class="text-sm text-gray-500 font-medium">Filter Bot:</span>
                <select id="botFilter" onchange="applyFilters()" class="flex-grow md:flex-none bg-base border border-border text-white text-sm rounded-xl px-4 py-2.5 outline-none focus:border-accent transition-colors">
                    <option value="all">Semua Jenis</option>
                    <option value="store">Store Bot</option>
                    <option value="guild">Guild Bot</option>
                    <option value="cc">CC Bot</option>
                </select>
            </div>
        </div>

        <!-- Tab Content: Baru & Perpanjang -->
        <div id="section-orders" class="grid grid-cols-1 gap-4">
            <% orders.forEach(order => { %>
                <div class="order-item order-card p-6 rounded-2xl flex flex-col md:flex-row gap-6" 
                     data-tipe="<%= order.tipe_order %>" 
                     data-bot="<%= (order.jenis_bot || 'store').toLowerCase() %>">
                    <div class="flex-shrink-0">
                        <% if (order.group && order.group.photo) { %>
                            <img src="<%= order.group.photo %>" alt="PP" class="w-20 h-20 rounded-2xl object-cover border border-border shadow-lg">
                        <% } else { %>
                            <div class="w-20 h-20 rounded-2xl bg-surface border border-border flex items-center justify-center text-gray-600">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            </div>
                        <% } %>
                    </div>
                    
                    <div class="flex-grow grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <span class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1">Customer</span>
                            <div class="text-white font-bold truncate text-sm"><%= order.email %></div>
                            <div class="text-accent text-xs font-semibold mt-1 truncate"><%= order.group ? order.group.name : 'Menunggu Bot Join...' %></div>
                            <div class="mt-3 flex gap-2">
                                <a href="<%= order.link_group %>" target="_blank" class="text-[10px] bg-accent/10 text-accent border border-accent/20 px-2 py-1 rounded font-bold hover:bg-accent hover:text-white transition-all">Link Grup</a>
                                <% if (order.group && order.group.jid) { %>
                                    <span class="text-[9px] text-gray-500 font-mono self-center px-2 py-1 bg-surface rounded"><%= order.group.jid %></span>
                                <% } %>
                            </div>
                        </div>
 
                        <div>
                            <span class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1">Detail Sewa</span>
                            <div class="text-gray-200 text-xs font-medium">
                                <% const safeBot = (order.jenis_bot || 'store').toLowerCase(); %>
                                <%= safeBot === 'v3' || safeBot === 'guild' ? 'GUILD BOT' : 
                                   (safeBot === 'v4' || safeBot === 'cc' ? 'CC BOT' : safeBot.toUpperCase()) %> 
                                - <%= order.paket %>
                            </div>
                            <div class="text-gray-500 text-[10px] mt-0.5"><%= order.durasi_hari %> Hari</div>
                            <div class="mt-3 flex items-center gap-2">
                                <span class="px-2 py-1 rounded text-[9px] font-black uppercase
                                    <%= order.status === 'PAID' ? 'bg-blue-500/10 text-blue-500' : 
                                       order.status === 'COMPLETED' ? 'bg-success/10 text-success' : 
                                       order.status === 'PENDING' ? 'bg-warning/10 text-warning' : 
                                       order.status === 'ERROR' ? 'bg-danger/10 text-danger' : 'bg-gray-800 text-gray-400' %>">
                                    <%= order.status %>
                                </span>
                                <span class="text-[9px] text-gray-600 font-mono"><%= order.id %></span>
                            </div>
                        </div>

                        <div class="flex flex-col justify-between md:text-right">
                            <div>
                                <span class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1">Waktu</span>
                                <div class="text-gray-400 text-[11px]"><%= new Date(order.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) %></div>
                            </div>
                            <div class="text-xl font-black text-white mt-2">
                                Rp <%= order.harga.toLocaleString('id-ID') %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
            <div id="no-orders" class="hidden text-center py-20 bg-surface rounded-3xl border border-border">
                <p class="text-gray-500 italic">Tidak ada pesanan ditemukan.</p>
            </div>
        </div>

        <!-- Tab Content: Semua Grup Aktif -->
        <div id="section-aktif" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% activeGroups.forEach(group => { %>
                <div class="active-item order-card p-5 rounded-2xl flex gap-4" data-bot="<%= group.jenisBot.toLowerCase() %>">
                    <div class="flex-shrink-0">
                        <% if (group.photo) { %>
                            <img src="<%= group.photo %>" alt="PP" class="w-14 h-14 rounded-xl object-cover border border-border">
                        <% } else { %>
                            <div class="w-14 h-14 rounded-xl bg-surface border border-border flex items-center justify-center text-gray-600">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                            </div>
                        <% } %>
                    </div>
                    <div class="flex-grow min-w-0 flex flex-col justify-center">
                        <div class="text-white font-bold truncate text-sm"><%= group.name || 'Unnamed Group' %></div>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="px-1.5 py-0.5 rounded text-[8px] font-black uppercase bg-accent/10 text-accent">
                                <%= group.jenisBot.toUpperCase() %>
                            </span>
                            <span class="flex items-center gap-1 text-[8px] text-gray-500 font-bold bg-surface px-1.5 py-0.5 rounded border border-border">
                                <svg class="w-2.5 h-2.5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path></svg>
                                <%= group.memberCount || 0 %>
                            </span>
                            <span class="text-[9px] text-gray-500 font-mono truncate max-w-[80px]"><%= group.jid %></span>
                        </div>
                        <div class="text-[9px] text-gray-400 mt-2 flex items-center gap-2">
                            <div class="flex items-center gap-1">
                                <svg class="w-3 h-3 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Exp: <span class="font-medium">
                                    <% 
                                        let exp = group.expiredAt;
                                        if (exp === 'PERMANENT' || exp === 'permanen') {
                                    %>
                                        PERMANEN
                                    <% } else if (!isNaN(exp) && exp !== null) { %>
                                        <%= new Date(parseInt(exp)).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' }) %>
                                    <% } else { %>
                                        <%= exp %>
                                    <% } %>
                                </span>
                            </div>
                            <span class="countdown-badge px-1.5 py-0.5 rounded-[4px] text-[8px] font-black uppercase transition-all duration-300" 
                                  data-expire="<%= exp %>">
                                CALC...
                            </span>
                        </div>
                    </div>
                </div>
            <% }) %>
            <div id="no-aktif" class="hidden col-span-full text-center py-20 bg-surface rounded-3xl border border-border">
                <p class="text-gray-500 italic">Tidak ada grup aktif ditemukan.</p>
            </div>
        </div>

        <!-- Tab Content: Settings -->
        <div id="section-settings" class="hidden max-w-2xl mx-auto mt-6">
            <div class="bg-surface border border-border p-8 rounded-3xl shadow-xl">
                <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-3">
                    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    Telegram Notification Settings
                </h2>
                
                <form id="settingsForm" onsubmit="saveSettings(event)" class="space-y-6">
                    <div>
                        <label for="telegramBotToken" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Telegram Bot Token</label>
                        <input type="text" id="telegramBotToken" name="telegramBotToken" value="<%= telegramBotToken %>" 
                               class="w-full bg-base border border-border text-white text-sm rounded-xl px-4 py-3 outline-none focus:border-accent transition-colors font-mono" 
                               placeholder="e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ">
                        <p class="text-[11px] text-gray-500 mt-1">Token bot Telegram yang digunakan untuk mengirim notifikasi.</p>
                    </div>

                    <div>
                        <label for="telegramOwnerId" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Telegram Owner Chat ID</label>
                        <input type="text" id="telegramOwnerId" name="telegramOwnerId" value="<%= telegramOwnerId %>" 
                               class="w-full bg-base border border-border text-white text-sm rounded-xl px-4 py-3 outline-none focus:border-accent transition-colors font-mono" 
                               placeholder="e.g. 987654321">
                        <p class="text-[11px] text-gray-500 mt-1">ID Telegram Owner yang akan menerima notifikasi order selesai.</p>
                    </div>

                    <div id="settingsMessage" class="hidden text-sm rounded-xl p-4"></div>

                    <button type="submit" 
                            class="w-full bg-accent hover:bg-accent/90 text-white font-bold py-3 px-4 rounded-xl transition-all duration-200 shadow-lg shadow-accent/20 flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
                        </svg>
                        Simpan Pengaturan
                    </button>
                </form>
            </div>
        </div>
    </main>

    <!-- Mobile Sidebar Menu Overlay -->
    <div id="mobile-sidebar-overlay" onclick="toggleMobileMenu(false)" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300"></div>

    <!-- Mobile Sidebar Container -->
    <div id="mobile-sidebar" class="fixed top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-surface border-l border-border z-50 transform translate-x-full transition-transform duration-300 ease-out flex flex-col p-6 shadow-2xl">
        <!-- Close Button -->
        <div class="flex items-center justify-between mb-8">
            <span class="font-bold text-lg text-white">Menu Admin</span>
            <button onclick="toggleMobileMenu(false)" class="text-gray-400 hover:text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Navigation Options inside Sidebar -->
        <div class="flex flex-col gap-3 flex-grow">
            <button onclick="selectMobileTab('baru')" id="m-btn-baru" class="mobile-tab-btn w-full text-left px-5 py-3.5 rounded-xl text-sm font-semibold transition-all text-gray-400 hover:bg-white/5 hover:text-white flex items-center gap-3">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Sewa Baru
            </button>
            <button onclick="selectMobileTab('perpanjang')" id="m-btn-perpanjang" class="mobile-tab-btn w-full text-left px-5 py-3.5 rounded-xl text-sm font-semibold transition-all text-gray-400 hover:bg-white/5 hover:text-white flex items-center gap-3">
                <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H12v3"></path></svg>
                Perpanjang
            </button>
            <button onclick="selectMobileTab('aktif')" id="m-btn-aktif" class="mobile-tab-btn w-full text-left px-5 py-3.5 rounded-xl text-sm font-semibold transition-all text-gray-400 hover:bg-white/5 hover:text-white flex items-center gap-3">
                <svg class="w-5 h-5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                Semua Grup
            </button>
            <button onclick="selectMobileTab('settings')" id="m-btn-settings" class="mobile-tab-btn w-full text-left px-5 py-3.5 rounded-xl text-sm font-semibold transition-all text-gray-400 hover:bg-white/5 hover:text-white flex items-center gap-3">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                Settings
            </button>
        </div>

        <!-- Logout inside Sidebar (At the bottom) -->
        <div class="border-t border-border pt-6">
            <a href="/user/admin/logout" class="w-full px-5 py-3.5 rounded-xl text-sm font-semibold transition-all text-danger hover:bg-danger/10 flex items-center gap-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                Logout
            </a>
        </div>
    </div>

    <script>
        function toggleTheme() {
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
                document.documentElement.classList.remove('dark');
                document.documentElement.classList.add('light-theme');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                document.documentElement.classList.remove('light-theme');
                localStorage.setItem('theme', 'dark');
            }
            updateThemeIcons();
        }

        function updateThemeIcons() {
            const isDark = document.documentElement.classList.contains('dark');
            document.querySelectorAll('.theme-icon-sun').forEach(el => el.style.display = isDark ? 'none' : 'block');
            document.querySelectorAll('.theme-icon-moon').forEach(el => el.style.display = isDark ? 'block' : 'none');
        }
        
        document.addEventListener('DOMContentLoaded', updateThemeIcons);

        let currentTab = 'baru';

        function updateCountdowns() {
            document.querySelectorAll('.countdown-badge').forEach(badge => {
                const expire = badge.dataset.expire;
                if (expire === 'PERMANENT' || expire === 'permanen') {
                    badge.innerText = 'PERMANEN';
                    badge.className = 'countdown-badge px-1.5 py-0.5 rounded-[4px] text-[8px] font-black uppercase bg-success/20 text-success';
                    return;
                }

                const expireTime = parseInt(expire);
                if (isNaN(expireTime)) {
                    badge.innerText = 'UNKNOWN';
                    return;
                }

                const now = Date.now();
                const diff = expireTime - now;

                if (diff <= 0) {
                    badge.innerText = 'EXPIRED';
                    badge.className = 'countdown-badge px-1.5 py-0.5 rounded-[4px] text-[8px] font-black uppercase bg-danger text-white';
                } else {
                    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                    const secs = Math.floor((diff % (1000 * 60)) / 1000);

                    let timeStr = "";
                    if (days > 0) timeStr += days + "D ";
                    timeStr += `${hours.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                    
                    badge.innerText = timeStr;
                    badge.className = 'countdown-badge px-1.5 py-0.5 rounded-[4px] text-[8px] font-black uppercase bg-success/20 text-success';
                }
            });
        }

        setInterval(updateCountdowns, 1000);
        updateCountdowns(); // Jalankan langsung saat load

        function toggleMobileMenu(open) {
            const overlay = document.getElementById('mobile-sidebar-overlay');
            const sidebar = document.getElementById('mobile-sidebar');

            if (open) {
                overlay.classList.remove('hidden');
                setTimeout(() => {
                    overlay.classList.add('opacity-100');
                    sidebar.classList.remove('translate-x-full');
                }, 10);
            } else {
                overlay.classList.remove('opacity-100');
                sidebar.classList.add('translate-x-full');
                setTimeout(() => {
                    overlay.classList.add('hidden');
                }, 300);
            }
        }

        function selectMobileTab(tab) {
            switchTab(tab);
            toggleMobileMenu(false);
        }

        function switchTab(tab) {
            currentTab = tab;
            
            // Update UI Buttons (Desktop)
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('bg-accent', 'text-white');
                btn.classList.add('text-gray-400');
            });
            const dBtn = document.getElementById('btn-' + tab);
            if (dBtn) {
                dBtn.classList.add('bg-accent', 'text-white');
                dBtn.classList.remove('text-gray-400');
            }

            // Update UI Buttons (Mobile Sidebar)
            document.querySelectorAll('.mobile-tab-btn').forEach(btn => {
                btn.classList.remove('bg-accent/10', 'text-accent');
                btn.classList.add('text-gray-400');
            });
            const mBtn = document.getElementById('m-btn-' + tab);
            if (mBtn) {
                mBtn.classList.add('bg-accent/10', 'text-accent');
                mBtn.classList.remove('text-gray-400');
            }

            // Update Active Tab Title (Mobile Badge)
            const titleMap = {
                'baru': 'Sewa Baru',
                'perpanjang': 'Perpanjang',
                'aktif': 'Semua Grup',
                'settings': 'Settings'
            };
            const mobileActiveTitle = document.getElementById('mobile-active-tab-title');
            if (mobileActiveTitle && titleMap[tab]) {
                mobileActiveTitle.innerText = titleMap[tab];
            }

            // Toggle Sections
            if (tab === 'aktif') {
                document.getElementById('section-orders').classList.add('hidden');
                document.getElementById('section-aktif').classList.remove('hidden');
                document.getElementById('section-settings').classList.add('hidden');
                updateCountdowns(); // Refresh countdown saat pindah tab
            } else if (tab === 'settings') {
                document.getElementById('section-orders').classList.add('hidden');
                document.getElementById('section-aktif').classList.add('hidden');
                document.getElementById('section-settings').classList.remove('hidden');
            } else {
                document.getElementById('section-orders').classList.remove('hidden');
                document.getElementById('section-aktif').classList.add('hidden');
                document.getElementById('section-settings').classList.add('hidden');
            }

            applyFilters();
        }

        async function saveSettings(event) {
            event.preventDefault();
            const botToken = document.getElementById('telegramBotToken').value;
            const ownerId = document.getElementById('telegramOwnerId').value;
            const messageEl = document.getElementById('settingsMessage');
            
            messageEl.classList.add('hidden');
            messageEl.className = 'text-sm rounded-xl p-4';

            try {
                const response = await fetch('/user/admin/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ telegramBotToken: botToken, telegramOwnerId: ownerId })
                });

                const result = await response.json();
                
                if (result.success) {
                    messageEl.innerText = 'Pengaturan berhasil disimpan!';
                    messageEl.classList.remove('hidden');
                    messageEl.className = 'text-sm rounded-xl p-4 bg-success/10 text-success border border-success/20';
                } else {
                    messageEl.innerText = result.message || 'Gagal menyimpan pengaturan.';
                    messageEl.classList.remove('hidden');
                    messageEl.className = 'text-sm rounded-xl p-4 bg-danger/10 text-danger border border-danger/20';
                }
            } catch (error) {
                messageEl.innerText = 'Terjadi kesalahan server.';
                messageEl.classList.remove('hidden');
                messageEl.className = 'text-sm rounded-xl p-4 bg-danger/10 text-danger border border-danger/20';
            }
        }

        function applyFilters() {
            if (currentTab === 'settings') return;
            const botFilter = document.getElementById('botFilter').value;
            let visibleCount = 0;

            if (currentTab === 'aktif') {
                document.querySelectorAll('.active-item').forEach(item => {
                    const dataBot = item.dataset.bot;
                    const matchBot = botFilter === 'all' || 
                                     dataBot === botFilter ||
                                     (botFilter === 'guild' && dataBot === 'v3') ||
                                     (botFilter === 'cc' && dataBot === 'v4');
                    
                    item.style.display = matchBot ? 'flex' : 'none';
                    if (matchBot) visibleCount++;
                });
                document.getElementById('no-aktif').classList.toggle('hidden', visibleCount > 0);
            } else {
                document.querySelectorAll('.order-item').forEach(item => {
                    const dataBot = item.dataset.bot;
                    const matchTipe = item.dataset.tipe === currentTab;
                    const matchBot = botFilter === 'all' || 
                                     dataBot === botFilter ||
                                     (botFilter === 'guild' && dataBot === 'v3') ||
                                     (botFilter === 'cc' && dataBot === 'v4');
                    
                    const isVisible = matchTipe && matchBot;
                    item.style.display = isVisible ? 'flex' : 'none';
                    if (isVisible) visibleCount++;
                });
                document.getElementById('no-orders').classList.toggle('hidden', visibleCount > 0);
            }
        }

        // Initialize
        window.onload = () => switchTab('baru');
    </script>
</body>
</html>
