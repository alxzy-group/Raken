            <!-- Bot Image -->
            <div data-aos="zoom-in" style="margin-bottom: 16px; border-radius: 24px; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 20px 60px var(--accent-light);">
                <img src="https://i.ibb.co.com/23h0hMBg/Beauty-Plus-20260323151557770-save.jpg" alt="Ravenzena Bot" style="width:240px;height:auto;display:block;">
            </div>

            <!-- Dynamic typing below thumbnail -->
            <div class="dynamic-typing-above-btn" style="margin-bottom: 28px; font-size: 14px;">
                <span style="opacity: 0.6;">Bot ini otomatis: </span><span id="typed-features" style="color: var(--accent);"></span>
            </div>

            <h1 class="hero-title">
                Otomatisasi Grup<br>
                <span class="grad">Tanpa Ribet.</span>
            </h1>

            <p class="hero-sub">
                Tingkatkan interaksi dan kelola grup komunitasmu dengan bot WhatsApp pintar yang dirancang khusus untuk mempermudah hidupmu. 
                Sistem kami berjalan 24/7 di server cloud berkinerja tinggi, menjamin setiap perintah dieksekusi tanpa delay panjang. 
                Sangat cocok untuk grup bisnis, komunitas game, jualan online, atau sekadar ruang diskusi seru-seruan.
            </p>

            <!-- Typing Animation for Descriptions -->
            <div class="typing-desc-container">
                <i class="fas fa-bolt" style="margin-right: 6px;"></i> <span id="typed-desc"></span>
            </div>



            <!-- WhatsApp & Telegram contacts -->
            <div class="hero-contacts">
                <template x-for="(contact, index) in contacts" :key="index">
                    <a :href="contact.type === 'whatsapp' ? 'https://wa.me/' + contact.id : 'https://t.me/' + contact.id"
                       target="_blank"
                       class="contact-pill" :class="contact.type === 'whatsapp' ? 'wa' : 'tg'">
                        <svg x-show="contact.type === 'whatsapp'" style="width:22px;height:22px" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path></svg>
                        <svg x-show="contact.type === 'telegram'" style="width:22px;height:22px" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.223-.548.223l.188-2.85 5.18-4.686c.223-.195-.054-.31-.353-.111l-6.4 4.024-2.76-.86c-.6-.188-.614-.6.126-.89l10.814-4.17c.506-.182.947.114.753.86z"></path></svg>
                        <span class="tooltip" x-text="contact.name"></span>
                    </a>
                </template>
            </div>

            <div class="hero-cta">
                <button @click="goToOrder()" class="btn-glow">
                    Mulai Berlangganan <i class="fas fa-arrow-right"></i>
                </button>
                <a href="#features" class="btn-outline-hero">
                    <i class="fas fa-bolt"></i> Lihat Fitur
                </a>
            </div>

            <div class="hero-stats">
                <div class="h-stat"><div class="h-stat-num">24/7</div><div class="h-stat-lbl">Aktif</div></div>
                <div class="h-stat"><div class="h-stat-num">QRIS</div><div class="h-stat-lbl">Otomatis</div></div>
                <div class="h-stat"><div class="h-stat-num">3</div><div class="h-stat-lbl">Tipe Bot</div></div>
                <div class="h-stat"><div class="h-stat-num">Easy</div><div class="h-stat-lbl">Setup</div></div>
            </div>

            <div class="scroll-ind">
                <span>SCROLL</span>
                <i class="fas fa-chevron-down"></i>
            </div>
        </section>

        <!-- Feature strip -->
        <section id="features" class="feat-strip" data-aos="fade-up">
            <div class="feat-card">
                <div class="feat-ico" style="background:rgba(16,185,129,.1); color:var(--success);"><i class="fab fa-whatsapp"></i></div>
                <div><div class="feat-title">WhatsApp Bot</div><div class="feat-desc">Bot resmi yang berjalan 24/7 di dalam grup WhatsApp kamu.</div></div>
            </div>
            <div class="feat-card">
                <div class="feat-ico" style="background:rgba(14,165,233,.1); color:var(--accent);"><i class="fas fa-robot"></i></div>
                <div><div class="feat-title">Respons Cepat</div><div class="feat-desc">Balasan instan untuk setiap perintah. Performa tinggi, minim delay.</div></div>
            </div>
            <div class="feat-card">
                <div class="feat-ico" style="background:rgba(139,92,246,.1); color:#8B5CF6;"><i class="fas fa-shield-alt"></i></div>
                <div><div class="feat-title">Anti-Spam</div><div class="feat-desc">Proteksi grup dari link spam, pesan berulang, dan bot liar secara otomatis.</div></div>
            </div>
            <div class="feat-card">
                <div class="feat-ico" style="background:rgba(236,72,153,.1); color:var(--pink);"><i class="fas fa-chart-bar"></i></div>
                <div><div class="feat-title">Statistik Grup</div><div class="feat-desc">Pantau aktivitas anggota, pesan masuk, dan keaktifan grup harian.</div></div>
