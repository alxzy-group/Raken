                                        </label>
                                    </div>

                                    <div x-show="orderType === 'perpanjang'" class="mb-6 p-4 bg-warning/10 border border-warning/20 rounded-xl flex items-center gap-3" x-transition>
                                        <div class="w-8 h-8 rounded-full bg-warning/20 text-warning flex items-center justify-center flex-shrink-0 re-invert">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        </div>
                                        <p class="text-[10px] md:text-xs font-bold text-warning leading-relaxed uppercase re-invert">
                                            PASTI KAN BOT YANG MAU DI PERPANJANG ADA DI DALAM GRUP
                                        </p>
                                    </div>

                                    <div class="grid grid-cols-2 gap-3 mb-8">
                                        <template x-for="(pkg, key) in (pricing[selectedBot] || {})" :key="key">
                                            <label class="cursor-pointer" data-aos="zoom-in">
                                                <input type="radio" name="paket" :value="key" x-model="selectedPackage" class="sr-only">
                                                <div class="p-4 rounded-xl border border-[#262626] bg-[#1a1a1a] text-center transition-all"
                                                    :class="selectedPackage === key ? 'border-[#3B82F6] bg-[#3B82F6]/20 ring-1 ring-[#3B82F6] shadow-md shadow-[#3B82F6]/20' : 'hover:border-gray-500'">
                                                    <div class="text-xs text-gray-300 font-medium mb-1" x-text="pkg.nama"></div>
                                                    <div class="text-lg font-extrabold text-white" x-text="'Rp ' + pkg.harga.toLocaleString('id-ID')"></div>
                                                </div>
                                            </label>
                                        </template>
                                    </div>

                                    <input type="hidden" name="jenis_bot" x-model="selectedBot">
                                    
                                    <button type="submit" :disabled="isLoading" class="w-full bg-white hover:bg-gray-200 text-black font-semibold py-4 rounded-xl transition-all flex items-center justify-center gap-2 disabled:opacity-50">
                                        <span x-text="isLoading ? 'Memproses Pesanan...' : 'Lanjutkan ke Pembayaran'"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <main x-show="view === 'checkout'" class="relative z-10 pt-24 pb-24 px-6" x-transition x-cloak>
            <div class="max-w-lg mx-auto">
                <div class="pro-card rounded-3xl p-8 md:p-10 text-center relative overflow-hidden">
                    
                    <div class="absolute top-0 left-0 w-full h-1 bg-surface">
                        <div class="h-full bg-accent transition-all duration-1000" :style="'width: ' + ((timeLeft/300)*100) + '%'"></div>
                    </div>

                    <div class="mb-8">
                        <h2 class="text-2xl font-bold text-white mb-2">Selesaikan Pembayaran</h2>
                        <div class="flex items-center justify-center gap-2 text-sm text-gray-400">
                            <span class="w-2 h-2 rounded-full bg-warning animate-pulse"></span>
                            Menunggu pembayaran masuk...
                        </div>
                    </div>

                    <!-- Admin Approval Warning -->
                    <div x-show="status === 'PENDING'" class="mb-8 p-4 bg-danger/10 border border-danger/20 rounded-2xl">
                        <p class="text-[10px] md:text-xs font-black text-danger uppercase leading-relaxed text-center re-invert">
                            ⚠️ PENTING: WAJIB MATIKAN FITUR PERSETUJUAN ADMIN GRUP AGAR BOT TIDAK ERROR SAAT JOIN ⚠️
                        </p>
                    </div>

                    <div class="inline-block p-4 bg-white rounded-2xl mb-8 shadow-lg shadow-accent/10 relative">
                        <img :src="'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(qrisData)" alt="QRIS" class="w-56 h-56 md:w-64 md:h-64 rounded-lg">

                        <div x-show="status !== 'PENDING'" class="absolute inset-0 bg-base/90 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center p-6 text-center">
                            
                            <template x-if="status === 'COMPLETED' || status === 'SUCCESS'">
                                <div class="space-y-3">
                                    <div class="w-12 h-12 bg-success/20 text-success rounded-full flex items-center justify-center mx-auto">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    </div>
                                    <div class="text-success font-bold text-lg">Pembayaran Berhasil!</div>
                                    <p class="text-gray-300 text-sm">Bot sedang dalam proses bergabung ke grup kamu.</p>
                                    
                                    <a :href="infoGroups[selectedBot] || '#'" target="_blank" class="block w-full mt-4 bg-accent hover:bg-blue-600 text-white px-4 py-3 rounded-lg font-bold text-sm transition-all">
                                        Gabung Grup Info Bot
                                    </a>

                                    <button @click="view = 'home'; history.pushState(null, '', '/')" class="mt-2 w-full border border-border text-white px-4 py-2 rounded-lg font-medium text-sm hover:bg-surface/50 transition-all">Kembali ke Beranda</button>
                                </div>
                            </template>

                            <template x-if="status === 'PAID'">
                                <div class="space-y-3">
                                    <div class="w-12 h-12 bg-accent/20 text-accent rounded-full flex items-center justify-center mx-auto animate-pulse">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    </div>
                                    <div class="text-accent font-bold text-lg">Dana Diterima</div>
                                    <p class="text-gray-300 text-sm">Pembayaranmu sudah masuk. Sistem sedang memproses...</p>
                                    
                                    <a :href="infoGroups[selectedBot] || '#'" target="_blank" class="block w-full mt-4 bg-accent hover:bg-blue-600 text-white px-4 py-3 rounded-lg font-bold text-sm transition-all">
                                        Gabung Grup Info Bot
                                    </a>
                                </div>
                            </template>

                            <template x-if="status === 'WAITING'">
                                <div class="space-y-3">
                                    <div class="w-12 h-12 bg-warning/20 text-warning rounded-full flex items-center justify-center mx-auto animate-spin">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                    </div>
                                    <div class="text-warning font-bold text-lg">Sedang Proses</div>
                                    <p class="text-gray-300 text-sm">Menunggu bot masuk ke grup kamu...</p>
                                    
                                    <a :href="infoGroups[selectedBot] || '#'" target="_blank" class="block w-full mt-4 bg-accent hover:bg-blue-600 text-white px-4 py-3 rounded-lg font-bold text-sm transition-all">
                                        Gabung Grup Info Bot
                                    </a>
                                </div>
                            </template>

                            <template x-if="status === 'ERROR'">
                                <div class="space-y-3">
                                    <div class="w-12 h-12 bg-danger/20 text-danger rounded-full flex items-center justify-center mx-auto">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    </div>
                                    <div class="text-danger font-bold text-lg">Gagal Join Grup</div>
                                    <p class="text-gray-300 text-sm">Ada kendala saat bot mencoba masuk. Hubungi admin.</p>
                                    <button @click="view = 'home'; history.pushState(null, '', '/')" class="mt-4 bg-white text-black px-4 py-2 rounded-lg font-medium text-sm">Kembali ke Beranda</button>
                                </div>
                            </template>

                            <template x-if="status === 'EXPIRED' || status === 'CANCELLED'">
                                <div class="space-y-3">
                                    <div class="text-danger font-bold text-lg" x-text="status === 'EXPIRED' ? 'Kedaluwarsa' : 'Dibatalkan'"></div>
                                    <p class="text-gray-300 text-sm">Waktu pembayaran habis atau pesanan dibatalkan.</p>
                                    <button @click="view = 'order'; history.pushState(null, '', '/')" class="mt-4 border border-border text-white px-4 py-2 rounded-lg font-medium text-sm hover:bg-surface/50 transition-all">Buat Pesanan Baru</button>
                                </div>
                            </template>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 text-left mb-8">
                        <div class="p-4 bg-surface border border-border rounded-xl">
                            <span class="block text-xs font-medium text-gray-500 mb-1">ID Pesanan</span>
                            <span class="font-mono text-sm text-white" x-text="orderId"></span>
                        </div>
                        <div class="p-4 bg-surface border border-border rounded-xl">
                            <span class="block text-xs font-medium text-gray-500 mb-1">Batas Waktu</span>
                            <span class="font-mono text-sm text-warning" x-text="formatTime()"></span>
                        </div>
                        <div class="col-span-2 p-5 bg-accent/5 border border-accent/20 rounded-xl flex justify-between items-center">
                            <span class="text-sm font-medium text-gray-400">Total Tagihan</span>
                            <span class="text-xl font-bold text-white" x-text="'Rp ' + harga.toLocaleString('id-ID')"></span>
                        </div>
                    </div>

                    <button @click="cancelOrder" class="text-sm font-medium text-gray-500 hover:text-danger transition-colors underline underline-offset-4">Batalkan Transaksi</button>

                    <div class="mt-8 pt-6 border-t border-border flex flex-col items-center justify-center gap-3">
                        <span class="text-xs text-gray-500 font-medium">Pembayaran didukung oleh:</span>
                        <div class="flex items-center gap-4 opacity-50 grayscale hover:grayscale-0 transition-all">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/a/a2/Logo_QRIS.svg" alt="QRIS" class="h-6">
                            <span class="text-sm font-bold text-white">Pakasir</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <footer class="border-t border-border py-12 bg-base relative z-10 mt-auto">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12">
            <div class="md:col-span-2">
                <div class="flex items-center gap-3 mb-6">
                    <img src="/favicon.png" alt="Ravenzena Logo" class="w-6 h-6 rounded object-cover">
                    <span class="font-bold text-lg text-white">Ravenzena Bot</span>
                </div>
                <p class="text-gray-400 text-sm max-w-sm leading-relaxed mb-6">
                    Solusi bot WhatsApp cerdas untuk mengelola dan meramaikan grup komunitasmu. Praktis, cepat, dan terpercaya.
                </p>
            </div>
            
            <div>
                <h5 class="text-white font-semibold text-sm mb-4">Layanan</h5>
                <ul class="space-y-3 text-sm text-gray-400">
                    <li><a href="#" class="hover:text-accent transition-colors">Cara Penggunaan</a></li>
                    <li><a href="#" class="hover:text-accent transition-colors">Status Server</a></li>
                    <li><a href="#" class="hover:text-accent transition-colors">Pembaruan Sistem</a></li>
                </ul>
            </div>
            
            <div>
                <h5 class="text-white font-semibold text-sm mb-4">Bantuan</h5>
                <ul class="space-y-3 text-sm text-gray-400">
                    <li><a href="#" class="hover:text-accent transition-colors">Hubungi Admin</a></li>
                    <li><a href="#" class="hover:text-accent transition-colors">Syarat & Ketentuan</a></li>
                    <li><a href="#" class="hover:text-accent transition-colors">Kebijakan Privasi</a></li>
                </ul>
            </div>
        </div>
        
        <div class="max-w-7xl mx-auto px-6 mt-12 pt-8 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4">
            <span class="text-sm text-gray-500">&copy; 2026 Ravenzena Bot. Hak Cipta Dilindungi.</span>
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-success"></div>
                    <span class="text-xs font-medium text-gray-400">Semua Sistem Normal</span>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
