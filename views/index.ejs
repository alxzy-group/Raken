                    </div>

                    <form @submit.prevent="submitForm" class="p-6 md:p-10" :class="isLoading ? 'opacity-50 pointer-events-none' : ''">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                            <div class="space-y-8">
                                <div>
                                    <h4 class="text-white font-semibold text-sm mb-6 flex items-center gap-3">
                                        <span class="w-6 h-6 rounded bg-surface border border-border flex items-center justify-center text-xs">1</span>
                                        Informasi Grup
                                    </h4>
                                    <div class="space-y-5">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-400 mb-2">Email Pengelola</label>
