                            <div class="w-12 h-12 bg-surface border border-border flex items-center justify-center rounded-lg mb-5 transition-colors"
                                :class="selectedBot === bot.id ? 'bg-accent/10 border-accent/30 text-accent' : 'text-gray-500'">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
