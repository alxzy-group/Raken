<!DOCTYPE html>
<html lang="id">
<head>
    <!-- Default to dark mode unless explicitly set to light -->
    <script>
        try {
            if (localStorage.getItem('theme') === 'light') {
                document.documentElement.classList.add('light-theme');
            } else {
                localStorage.setItem('theme', 'dark');
            }
        } catch(e) {}
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= siteSettings && siteSettings.siteDescription ? siteSettings.siteDescription : 'Bot WhatsApp untuk komunitas yang lebih rapi dan aktif.' %>">
    <meta property="og:title" content="<%= siteSettings && siteSettings.siteName ? siteSettings.siteName : 'Ravenzena Bot' %>">
    <meta property="og:description" content="<%= siteSettings && siteSettings.siteDescription ? siteSettings.siteDescription : 'Bot WhatsApp untuk komunitas yang lebih rapi dan aktif.' %>">
    <meta property="og:image" content="<%= siteSettings && siteSettings.heroImageUrl ? siteSettings.heroImageUrl : '/favicon.png' %>">
    <title><%= siteSettings && siteSettings.siteName ? siteSettings.siteName : 'Ravenzena Bot' %> | Layanan Bot WhatsApp</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" href="/favicon.png">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://unpkg.com/@fortawesome/fontawesome-free@6.5.2/css/all.min.css">
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://unpkg.com/typed.js@2.1.0/dist/typed.umd.js"></script>

    <style>
        [x-cloak] { display: none !important; }

        /* ─── PREMIUM MAGENTA ACCENT ─── */
        :root {
            --accent: #d946ef; /* Fuchsia/Magenta */
            --accent-glow: rgba(217, 70, 239, 0.3);
            --primary-glow: rgba(217, 70, 239, 0.15);
        }

        /* ─── TRUE LIGHT MODE ─── */
        html.light-theme {
            --bg: #FFFFFF;
            --bg-card: #FAFAFA;
            --bg-card2: #F4F4F5;
            --bg-glass: rgba(0, 0, 0, 0.04);
            --border: rgba(0, 0, 0, 0.08);
            --border-hover: rgba(0, 0, 0, 0.15);
            --text: #18181B;
            --text-muted: #52525B;
            --text-dim: #A1A1AA;
            --primary: #18181B;
            --primary-d: #27272A;
            background-color: var(--bg);
            color: var(--text);
        }
        
        /* Light mode specific overrides */
        html.light-theme .grid-lines {
            background-image:
                linear-gradient(to right, rgba(0,0,0,.06) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0,0,0,.06) 1px, transparent 1px);
        }
        html.light-theme .hero-title .grad {
            background: linear-gradient(135deg, #0F172A 0%, #475569 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        html.light-theme .hero-eyebrow, html.light-theme .h-stat, html.light-theme .feat-card, html.light-theme .bot-card, html.light-theme .form-card, html.light-theme .pkg-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            box-shadow: 0 8px 30px rgba(0,0,0,0.04);
        }
        html.light-theme .hero-section::before {
            background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
        }
        html.light-theme .btn-glow {
            background: var(--accent);
            color: #FFFFFF;
            box-shadow: 0 4px 14px var(--accent-glow);
        }
        html.light-theme .btn-outline-hero {
            background: rgba(0,0,0,.04);
            border-color: rgba(0,0,0,.1);
            color: var(--text);
        }
        html.light-theme .form-input {
            background: var(--bg-card2);
            border-color: var(--border);
            color: var(--text);
        }
        html.light-theme ::-webkit-scrollbar-track { background: #FFFFFF; }
        html.light-theme ::-webkit-scrollbar-thumb { background: #D4D4D8; }
        
        /* Navbar specific override for light mode */
        html.light-theme .navbar {
            background: rgba(255, 255, 255, 0.85);
            border-bottom: 1px solid var(--border);
            box-shadow: 0 4px 30px rgba(0,0,0,0.03);
        }

        /* ─── Grid-lines background ─── */
        .grid-lines {
            position: fixed;
            inset: 0;
            z-index: 0;
            opacity: 0.6;
            pointer-events: none;
            background-image:
                linear-gradient(to right, rgba(255,255,255,.05) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,.05) 1px, transparent 1px);
            background-size: 32px 32px;
        }

        /* ─── Hero ─── */
        .hero-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 120px 20px 80px;
        }

        /* Gradient orb behind hero */
        .hero-section::before {
            content: '';
            position: absolute;
            width: 700px; height: 700px;
            top: -250px; left: 50%;
            transform: translateX(-50%);
            background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
            opacity: 0.8;
            mix-blend-mode: screen;
        }

        .hero-eyebrow {
            position: relative; z-index: 2;
            display: inline-flex; align-items: center; gap: 8px;
            background: var(--bg-glass);
            border: 1px solid var(--border);
            border-radius: 100px;
            padding: 6px 18px;
            font-size: 12.5px; font-weight: 600;
            color: var(--text);
            letter-spacing: .08em; text-transform: uppercase;
            margin-bottom: 28px;
            backdrop-filter: blur(12px);
            animation: fsd .6s ease both;
        }

        .eyebrow-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: var(--accent);
            animation: dotPulse 1.5s ease-in-out infinite;
        }
        @keyframes dotPulse {
            0%,100% { opacity:1; transform:scale(1); }
            50%     { opacity:.5; transform:scale(1.5); }
        }
        @keyframes fsd {
            from { opacity:0; transform:translateY(-20px); }
            to   { opacity:1; transform:translateY(0); }
        }

        .hero-title {
            position: relative; z-index: 2;
            font-size: clamp(46px, 8vw, 96px);
            font-weight: 900;
            letter-spacing: -.04em;
            line-height: 1;
            text-align: center;
            margin-bottom: 20px;
            animation: fsd .7s .1s ease both;
        }
        .hero-title .grad {
            background: linear-gradient(135deg, #ffffff 0%, #a1a1aa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-sub {
            position: relative; z-index: 2;
            font-size: 17px; color: var(--text-muted);
            text-align: center; max-width: 600px;
            margin-bottom: 30px;
            animation: fsd .7s .2s ease both;
            line-height: 1.6;
        }

        .typing-desc-container {
            position: relative; z-index: 2;
            font-size: 15px; font-weight: 600;
            color: var(--accent);
            text-align: center;
            margin-bottom: 40px;
            min-height: 24px;
            animation: fsd .7s .25s ease both;
        }

        .dynamic-typing-above-btn {
            position: relative; z-index: 2;
            text-align: center;
            margin-bottom: 12px;
            font-size: 13px; font-weight: 700;
            color: var(--text-muted);
            letter-spacing: .05em;
            text-transform: uppercase;
            animation: fsd .7s .3s ease both;
        }

        .hero-cta {
            position: relative; z-index: 2;
            display: flex; gap: 14px; flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 40px;
            animation: fsd .7s .3s ease both;
        }

        .hero-contacts {
            position: relative; z-index: 2;
            display: flex; gap: 12px; flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 50px;
            animation: fsd .7s .35s ease both;
        }
        .contact-pill {
            width: 48px; height: 48px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            transition: all .25s;
            position: relative;
            cursor: pointer;
            border: 1px solid transparent;
        }
        .contact-pill.wa {
            background: rgba(16,185,129,.1);
            color: var(--success);
        }
        .contact-pill.wa:hover {
            background: var(--success);
            color: #fff;
            border-color: var(--success);
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(16,185,129,.3);
        }
        .contact-pill.tg {
            background: rgba(59,130,246,.1);
            color: #3B82F6;
        }
        .contact-pill.tg:hover {
            background: #3B82F6;
            color: #fff;
            border-color: #3B82F6;
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(59,130,246,.3);
        }
        .contact-pill .tooltip {
            position: absolute;
            bottom: -28px;
            white-space: nowrap;
            font-size: 11px;
            color: var(--text-muted);
            opacity: 0;
            transition: opacity .2s;
        }
        .contact-pill:hover .tooltip { opacity: 1; }

        .hero-stats {
            position: relative; z-index: 2;
            display: flex; gap: 16px; flex-wrap: wrap;
            justify-content: center;
            animation: fsd .7s .4s ease both;
        }

        .h-stat {
            background: var(--bg-glass);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 16px 24px;
            text-align: center;
            min-width: 100px;
            backdrop-filter: blur(12px);
            transition: all .25s;
        }
        .h-stat:hover {
            background: var(--bg-card2);
            border-color: var(--accent);
            transform: translateY(-3px);
        }
        .h-stat-num {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: -.03em;
            line-height: 1;
            margin-bottom: 4px;
        }
        .h-stat-lbl {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--text-dim);
        }

        .scroll-ind {
            position: absolute;
            bottom: 32px; left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            display: flex; flex-direction: column; align-items: center; gap: 6px;
            color: var(--text-dim);
            font-size: 11px;
            letter-spacing: .1em;
            animation: scrollBounce 2s ease-in-out infinite;
        }
        @keyframes scrollBounce {
            0%,100% { transform: translateX(-50%) translateY(0); }
            50%     { transform: translateX(-50%) translateY(8px); }
        }

        /* ─── Feature strip ─── */
        .feat-strip {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            padding: 0 20px;
            max-width: 1100px;
            margin: 0 auto 80px;
        }
        .feat-card {
            background: var(--bg-glass);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 22px 20px;
            display: flex; align-items: flex-start; gap: 16px;
            transition: all .25s;
        }
        .feat-card:hover {
            background: var(--bg-card2);
            border-color: var(--accent);
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0,0,0,.3);
        }
        .feat-ico {
            width: 44px; height: 44px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; flex-shrink: 0;
        }
        .feat-title { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
        .feat-desc  { font-size: 12.5px; color: var(--text-muted); line-height: 1.5; }

        /* ─── Section headings ─── */
        .sec-label {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: 11.5px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .12em;
            color: var(--accent);
            margin-bottom: 10px;
        }
        .sec-heading {
            font-size: clamp(26px, 4vw, 40px);
            font-weight: 900;
            letter-spacing: -.03em;
            color: var(--text);
            margin-bottom: 8px;
        }
        .sec-sub {
            font-size: 15px;
            color: var(--text-muted);
            margin-bottom: 36px;
        }

        /* ─── Bot selection cards ─── */
        .bot-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 18px;
            margin-bottom: 30px;
        }
        .bot-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 24px;
            position: relative;
            overflow: hidden;
            cursor: pointer;
            transition: all .3s cubic-bezier(.34,1.56,.64,1);
            display: flex; flex-direction: column; gap: 14px;
        }
        .bot-card::before {
            content: '';
            position: absolute; inset: 0;
            border-radius: inherit;
            background: linear-gradient(135deg, var(--accent-light) 0%, transparent 60%);
            opacity: 0; transition: opacity .3s;
        }
        .bot-card::after {
            content: '';
            position: absolute; top: -60px; right: -60px;
            width: 160px; height: 160px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
            opacity: 0; transition: opacity .3s;
        }
        .bot-card:hover {
            border-color: var(--accent);
            transform: translateY(-6px) scale(1.01);
            box-shadow: 0 20px 60px rgba(0,0,0,.5), 0 0 40px var(--accent-light);
        }
        .bot-card:hover::before, .bot-card:hover::after { opacity: 1; }
        .bot-card.active {
            border-color: var(--accent);
            box-shadow: 0 0 0 2px var(--accent-glow);
        }
        .bot-card .shimmer {
            position: absolute; top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            opacity: 0; transition: opacity .3s;
        }
        .bot-card:hover .shimmer, .bot-card.active .shimmer { opacity: 1; }
        .bot-card-icon {
            width: 48px; height: 48px;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
            position: relative; z-index: 1;
        }
        .bot-card-title { font-size: 18px; font-weight: 700; position: relative; z-index: 1; }
        .bot-card-desc  { font-size: 13px; color: var(--text-muted); line-height: 1.5; position: relative; z-index: 1; }

        /* ─── Package cards ─── */
        .pkg-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 24px;
        }
        .pkg-card {
            background: var(--bg-glass);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px;
            text-align: center;
            cursor: pointer;
            transition: all .25s;
        }
        .pkg-card:hover {
            border-color: var(--border-hover);
            transform: translateY(-2px);
            background: var(--bg-card2);
        }
        .pkg-card.active {
            border-color: var(--accent);
            background: var(--accent-light);
            box-shadow: 0 0 20px var(--accent-glow);
        }

        /* ─── Order form ─── */
        .order-section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 100px 20px 80px;
            position: relative; z-index: 10;
        }
        .form-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 24px;
            overflow: hidden;
            position: relative;
        }
        .form-card::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
        }
        .loading-overlay {
            position: absolute; inset: 0;
            background: rgba(0,0,0,.7);
            backdrop-filter: blur(4px);
            z-index: 50;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 16px;
        }
        .spinner {
            width: 48px; height: 48px;
            border: 4px solid rgba(14,165,233,.2);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin .8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        .form-input {
            width: 100%;
            background: var(--bg-glass);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 16px;
            color: var(--text);
            font-family: var(--font);
            font-size: 14px;
            outline: none;
            transition: all .2s;
        }
        .form-input::placeholder { color: var(--text-dim); }
        .form-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(14,165,233,.1); }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .btn-glow {
            display: inline-flex; align-items: center; gap: 10px;
            background: var(--primary); color: var(--bg);
            font-weight: 700; font-size: 15px;
            padding: 14px 32px;
            border-radius: 100px;
            text-decoration: none; border: none; cursor: pointer;
            position: relative; overflow: hidden;
            box-shadow: 0 4px 14px rgba(255,255,255,0.1);
            transition: transform .2s, box-shadow .2s;
            font-family: var(--font);
        }
        .btn-glow:hover {
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 6px 20px rgba(255,255,255,0.15);
        }
        .btn-outline-hero {
            display: inline-flex; align-items: center; gap: 10px;
            background: var(--bg-glass);
            color: var(--text);
            font-weight: 600; font-size: 15px;
            padding: 14px 28px;
            border-radius: 100px;
            text-decoration: none;
            border: 1px solid var(--border);
            backdrop-filter: blur(12px);
            transition: all .2s;
            font-family: var(--font);
            cursor: pointer;
        }
        .btn-outline-hero:hover {
            background: rgba(255,255,255,.09);
            border-color: rgba(255,255,255,.2);
            transform: translateY(-2px);
        }

        .btn-accent {
            background: var(--accent);
            color: #fff;
            font-weight: 700;
            border: none; cursor: pointer;
            padding: 12px 20px;
            border-radius: 12px;
            font-family: var(--font);
            font-size: 14px;
            transition: all .2s;
            box-shadow: 0 4px 20px rgba(14,165,233,.2);
        }
        .btn-accent:hover { opacity: .9; transform: translateY(-1px); }
        .btn-accent:disabled { opacity: .5; cursor: not-allowed; }

        .toggle-bar {
            display: flex;
            padding: 4px;
            background: var(--bg-glass);
            border: 1px solid var(--border);
            border-radius: 12px;
        }
        .toggle-bar label { flex: 1; cursor: pointer; }
        .toggle-bar .t-opt {
            display: block;
            padding: 10px;
            text-align: center;
            font-size: 14px; font-weight: 600;
            border-radius: 8px;
            transition: all .2s;
            color: var(--text-muted);
        }
        .toggle-bar .t-opt.on {
            background: var(--accent);
            color: #fff;
            box-shadow: 0 2px 12px var(--accent-glow);
        }

        /* ─── Checkout ─── */
        .checkout-section {
            max-width: 520px;
            margin: 0 auto;
            padding: 100px 20px 80px;
            position: relative; z-index: 10;
        }
        .qris-wrap {
            background: #fff;
            border-radius: 18px;
            padding: 16px;
            display: inline-block;
            box-shadow: 0 8px 30px rgba(14,165,233,.1);
        }
        .status-overlay {
            position: absolute; inset: 0;
            background: rgba(0,0,0,.88);
            backdrop-filter: blur(4px);
            border-radius: 18px;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            padding: 24px; z-index: 10;
        }

        /* ─── Footer ─── */
        .site-footer {
            border-top: 1px solid var(--border);
            padding: 60px 20px 40px;
            position: relative; z-index: 10;
        }
        .footer-grid {
            max-width: 1100px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 40px;
        }
        .footer-title { font-size: 14px; font-weight: 700; margin-bottom: 16px; }
        .footer-links { list-style: none; padding: 0; }
        .footer-links li { margin-bottom: 10px; }
        .footer-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13px;
            transition: color .2s;
        }
        .footer-links a:hover { color: var(--accent); }
        .footer-bottom {
            max-width: 1100px;
            margin: 40px auto 0;
            padding-top: 24px;
            border-top: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: center;
            font-size: 13px; color: var(--text-dim);
        }
        .status-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--success);
            display: inline-block;
            margin-right: 6px;
            box-shadow: 0 0 10px var(--success);
        }

        @media (max-width: 768px) {
            .footer-grid { grid-template-columns: 1fr; gap: 30px; }
            .footer-bottom { flex-direction: column; gap: 12px; text-align: center; }
            .navbar-links .nav-link { display: none; }
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            AOS.init({ duration: 800, once: true });
            
            // Hero description typing
            new Typed('#typed-desc', {
                strings: [
                    'Memberikan kemudahan moderasi grup tanpa campur tangan manual.',
                    'Dilengkapi fitur keamanan tingkat tinggi untuk mencegah spam.',
                    'Mengelola komunitasmu selama 24 jam penuh tanpa lelah.',
                    'Dapatkan laporan aktivitas grup secara lengkap dan real-time.'
                ],
                typeSpeed: 40,
                backSpeed: 20,
                backDelay: 3000,
                loop: true,
                showCursor: true,
                cursorChar: '|'
            });

            // Dynamic typing above contacts
            new Typed('#typed-features', {
                strings: [
                    'Menyapa member baru 👋',
                    'Menghapus link spam 🛡️',
                    'Mencatat aktivitas grup 📊',
                    'Bikin games interaktif 🎮'
                ],
                typeSpeed: 50,
                backSpeed: 30,
                backDelay: 2000,
                loop: true,
                showCursor: false
            });

            // --- Premium Canvas Particle Animation ---
            const canvas = document.getElementById('bg-canvas');
            const ctx = canvas.getContext('2d');
            let width, height;
            
            function resize() {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();
            
            const particles = [];
            const isLight = () => document.documentElement.classList.contains('light-theme');
            
            for(let i = 0; i < 40; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    size: Math.random() * 2 + 0.5,
                    vx: (Math.random() - 0.5) * 0.5,
                    vy: (Math.random() - 0.5) * 0.5,
                    alpha: Math.random() * 0.5 + 0.1
                });
            }
            
            function animate() {
                ctx.clearRect(0, 0, width, height);
                const lightMode = isLight();
                
                particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;
                    
                    if(p.x < 0 || p.x > width) p.vx *= -1;
                    if(p.y < 0 || p.y > height) p.vy *= -1;
                    
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    // Use magenta/purple hues, adapt opacity based on theme
                    ctx.fillStyle = lightMode 
                        ? `rgba(217, 70, 239, ${p.alpha * 0.8})` 
                        : `rgba(217, 70, 239, ${p.alpha})`;
                    ctx.fill();
                });
                
                requestAnimationFrame(animate);
            }
            animate();
        });

        document.addEventListener('alpine:init', () => {
            Alpine.data('ravenApp', () => ({
                view: (<%- JSON.stringify(typeof orderId !== 'undefined' ? orderId : '') %> && <%- JSON.stringify(typeof status !== 'undefined' ? status : 'PENDING') %> === 'PENDING') ? 'checkout' : 'home',
                mobileMenuOpen: false,
                pricing: <%- JSON.stringify(typeof pricing !== 'undefined' ? pricing : {}) %>,
                contacts: <%- JSON.stringify(typeof contacts !== 'undefined' ? contacts : []) %>,
                infoGroups: <%- JSON.stringify(typeof infoGroups !== 'undefined' ? infoGroups : {}) %>,
                selectedBot: '<%- typeof jenis_bot !== 'undefined' ? jenis_bot : 'store' %>',
                orderType: 'baru',
                selectedPackage: 'paket2',
                orderId: <%- JSON.stringify(typeof orderId !== 'undefined' ? orderId : '') %>,
                qrisData: <%- JSON.stringify(typeof qris !== 'undefined' ? qris : '') %>,
                harga: <%= typeof harga !== 'undefined' && harga ? harga : 0 %>,
                status: <%- JSON.stringify(typeof status !== 'undefined' ? status : 'PENDING') %>,
                timeLeft: 300,
                isLoading: false,
                formError: '',
                isDarkMode: false,

                voucherCode: '',
                voucherValid: false,
                voucherDiscount: 0,
                voucherType: 'percent',
                isValidatingVoucher: false,
                voucherMessage: '',

                get finalPrice() {
                    let basePrice = 0;
                    if (this.pricing && this.pricing[this.selectedBot] && this.pricing[this.selectedBot][this.selectedPackage]) {
                        basePrice = this.pricing[this.selectedBot][this.selectedPackage].harga;
                    }
                    if (this.voucherValid) {
                        if (this.voucherType === 'percent') {
                            basePrice = basePrice - (basePrice * (this.voucherDiscount / 100));
                        } else {
                            basePrice = basePrice - this.voucherDiscount;
                        }
                    }
                    return basePrice < 0 ? 0 : Math.round(basePrice);
                },

                initTheme() {
                    const savedTheme = localStorage.getItem('theme');
                    if (savedTheme === 'light') {
                        this.isDarkMode = false;
                        document.documentElement.classList.add('light-theme');
                    } else {
                        this.isDarkMode = true;
                        localStorage.setItem('theme', 'dark');
                        document.documentElement.classList.remove('light-theme');
                    }
                },
                toggleTheme() {
                    this.isDarkMode = !this.isDarkMode;
                    if (this.isDarkMode) {
                        document.documentElement.classList.remove('light-theme');
                        localStorage.setItem('theme', 'dark');
                    } else {
                        document.documentElement.classList.add('light-theme');
                        localStorage.setItem('theme', 'light');
                    }
                },

                init() {
                    this.initTheme();
                    if (this.pricing && this.pricing[this.selectedBot]) {
                        const pkgs = Object.keys(this.pricing[this.selectedBot]);
                        if (pkgs.length > 0 && !this.pricing[this.selectedBot][this.selectedPackage]) {
                            this.selectedPackage = pkgs[0];
                        }
                    }
                    if (this.view === 'checkout') {
                        this.startTimers();
                    }
                },

                goToOrder() {
                    this.view = 'order';
                    this.mobileMenuOpen = false;
                    this.$nextTick(() => { window.scrollTo({ top: 0, behavior: 'smooth' }); });
                },
                goToHome() {
                    this.view = 'home';
                    this.mobileMenuOpen = false;
                    history.pushState(null, '', '/');
                    this.$nextTick(() => { window.scrollTo({ top: 0, behavior: 'smooth' }); });
                },

                resetVoucher() {
                    this.voucherValid = false;
                    this.voucherDiscount = 0;
                    this.voucherMessage = '';
                },

                selectBot(botId) {
                    if (this.selectedBot !== botId) this.resetVoucher();
                    this.selectedBot = botId;
                    const pkgs = Object.keys(this.pricing[botId] || {});
                    this.selectedPackage = pkgs.length > 0 ? pkgs[0] : '';
                },

                async checkVoucher() {
                    if (!this.voucherCode) return;
                    this.isValidatingVoucher = true;
                    this.voucherMessage = '';
                    this.voucherValid = false;
                    try {
                        const res = await fetch('/api/validate-voucher', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ code: this.voucherCode, jenis_bot: this.selectedBot })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.voucherValid = true;
                            this.voucherDiscount = data.discount;
                            this.voucherType = data.type;
                            this.voucherMessage = `Voucher berhasil! Diskon ${data.type === 'percent' ? data.discount + '%' : 'Rp ' + data.discount.toLocaleString('id-ID')}`;
                        } else {
                            this.voucherMessage = data.error || 'Voucher tidak valid';
                        }
                    } catch (e) {
                        this.voucherMessage = 'Gagal memvalidasi voucher';
                    }
                    this.isValidatingVoucher = false;
                },

                async submitForm(e) {
                    this.isLoading = true;
                    this.formError = '';
                    const formData = new FormData(e.target);
                    const data = Object.fromEntries(formData.entries());
                    try {
                        const res = await fetch('/checkout', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await res.json();
                        if (result.success) {
                            this.orderId = result.orderId;
                            this.qrisData = result.qris;
                            this.harga = result.harga;
                            this.status = result.status || 'PENDING';
                            this.selectedBot = result.jenis_bot || this.selectedBot;
                            this.timeLeft = 300;
                            history.pushState(null, '', '/?checkout=' + this.orderId);
                            this.view = 'checkout';
                            this.startTimers();
                            setTimeout(() => { window.scrollTo({ top: 0, behavior: 'smooth' }); }, 100);
                        } else {
                            this.formError = result.message || 'Pesanan belum dapat diproses.';
                        }
                    } catch (err) {
                        this.formError = 'Server tidak dapat dijangkau.';
                    }
                    this.isLoading = false;
                },

                startTimers() {
                    const timer = setInterval(() => {
                        if (this.timeLeft > 0 && this.status === 'PENDING') {
                            this.timeLeft--;
                        } else {
                            clearInterval(timer);
                            if (this.timeLeft === 0 && this.status === 'PENDING') this.status = 'EXPIRED';
                        }
                    }, 1000);
                    const poll = setInterval(async () => {
                        if (['COMPLETED', 'SUCCESS', 'EXPIRED', 'CANCELLED', 'ERROR'].includes(this.status)) {
                            clearInterval(poll); return;
                        }
                        try {
                            const res = await fetch('/status/' + this.orderId);
                            const data = await res.json();
                            this.status = data.status || this.status;
                        } catch (e) { }
                    }, 5000);
                },

                async cancelOrder() {
                    if (!confirm('Yakin ingin membatalkan pesanan ini?')) return;
                    this.isLoading = true;
                    try {
                        const res = await fetch('/cancel/' + this.orderId, { method: 'POST' });
                        const result = await res.json();
                        if (result.success) this.status = 'CANCELLED';
                    } catch (err) { alert('Gagal membatalkan pesanan.'); }
                    this.isLoading = false;
                },

                formatTime() {
                    let m = Math.floor(this.timeLeft / 60);
                    let s = this.timeLeft % 60;
                    return `${m}:${s < 10 ? '0' : ''}${s}`;
                }
            }));
        });
    </script>
</head>
<body x-data="ravenApp">

    <!-- Premium Canvas Animation -->
    <canvas id="bg-canvas" style="position:fixed; inset:0; z-index:0; pointer-events:none;"></canvas>

    <!-- Grid-lines background -->
    <div class="grid-lines"></div>

    <!-- Navbar -->
    <nav class="navbar">
        <a href="#" @click.prevent="goToHome()" class="navbar-brand">
            <img src="<%= siteSettings && siteSettings.logoUrl ? siteSettings.logoUrl : '/favicon.png' %>" alt="Logo" style="width:32px;height:32px;border-radius:8px;object-fit:cover;">
            <span>Ravenzena <span style="color:var(--accent)">Bot</span></span>
        </a>
        <div class="navbar-links">
            <a href="#" @click.prevent="goToHome()" class="nav-link" :class="view === 'home' ? 'active' : ''">Fitur</a>
            <a href="#" @click.prevent="goToOrder()" class="nav-link" :class="view === 'order' ? 'active' : ''">Harga</a>
            
            <!-- Theme Toggle -->
            <button @click="toggleTheme()" style="width:36px;height:36px;border-radius:12px;background:var(--bg-glass);border:1px solid var(--border);color:var(--text);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;margin-left:4px;box-shadow:0 4px 12px rgba(0,0,0,.1);">
                <i x-show="isDarkMode" class="fas fa-moon" style="font-size:14px;color:var(--accent);"></i>
                <i x-show="!isDarkMode" class="fas fa-sun" style="font-size:14px;color:#F59E0B;"></i>
            </button>

            <button x-show="view === 'home'" @click="goToOrder()" class="btn-glow" style="margin-left:12px;padding:10px 24px;font-size:13.5px;box-shadow:0 0 20px rgba(14,165,233,.2);background:var(--accent);color:#fff;">Pesan Sekarang</button>
            <button x-show="view !== 'home'" @click="goToHome()" class="btn-outline-hero" style="margin-left:12px;padding:10px 24px;font-size:13.5px;">← Beranda</button>
        </div>
    </nav>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- HOME VIEW                                          -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div x-show="view === 'home'" x-transition x-cloak>
        <section class="hero-section">
            <div class="hero-eyebrow">
                <div class="eyebrow-dot"></div>
                Pembaruan v4.0 sudah rilis 🎉
