<!DOCTYPE html>
<html lang="id" class="light-theme">
<head>
    <script>
        try {
            localStorage.setItem('theme', 'light');
            if (localStorage.getItem('theme') === 'light') {
                document.documentElement.classList.remove('dark');
                document.documentElement.classList.add('light-theme');
            }
        } catch(e) {}
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ravenzena Bot | Layanan Bot WhatsApp</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" href="/favicon.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        base: '#050505',
                        surface: '#111111',
                        border: '#262626',
                        accent: '#3B82F6',
                        success: '#10B981',
                        warning: '#F59E0B',
                        danger: '#EF4444'
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            background-color: #050505;
            color: #E5E7EB;
            scroll-behavior: smooth;
        }
        .grid-lines {
            background-image: linear-gradient(to right, #111111 1px, transparent 1px),
                linear-gradient(to bottom, #111111 1px, transparent 1px);
            background-size: 40px 40px;
        }
        .pro-card {
            background: #0A0A0A;
            border: 1px solid #262626;
            transition: all 0.2s ease-in-out;
        }
        .pro-card:hover { border-color: #3B82F6; }
        .active-module { border-color: #3B82F6; background: rgba(59, 130, 246, 0.05); }
        [x-cloak] { display: none !important; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #050505; }
        ::-webkit-scrollbar-thumb { background: #262626; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #3B82F6; }
    
        /* MAGIC LIGHT MODE */
        html.light-theme {
            filter: invert(1) hue-rotate(180deg);
            background-color: #FAFAFA; /* Inverted #050505 */
        }
        /* Re-invert images so they don't look like negatives */
        html.light-theme img, 
        html.light-theme .re-invert {
            filter: invert(1) hue-rotate(180deg); 
        }
        /* Force stronger colors for danger/warning in light mode */
        html.light-theme .text-danger.re-invert {
            color: #DC2626 !important;
            font-weight: 900 !important;
        }
        html.light-theme .text-warning.re-invert {
            color: #D97706 !important;
            font-weight: 900 !important;
        }
        /* Optional: adjust scrollbar for light mode since it's inverted globally */
        html.light-theme ::-webkit-scrollbar-track { background: #FAFAFA; }
        html.light-theme ::-webkit-scrollbar-thumb { background: #D9D9D9; }

    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            AOS.init({
                duration: 800,
                once: true,
            });
        });

        document.addEventListener('alpine:init', () => {
            Alpine.data('ravenApp', () => ({
                view: (<%- JSON.stringify(typeof orderId !== 'undefined' ? orderId : '') %> && <%- JSON.stringify(typeof status !== 'undefined' ? status : 'PENDING') %> === 'PENDING') ? 'checkout' : 'home',
                mobileMenuOpen: false,
                pricing: <%- JSON.stringify(typeof pricing !== 'undefined' ? pricing : {}) %>,
                contacts: <%- JSON.stringify(typeof contacts !== 'undefined' ? contacts : []) %>,
                infoGroups: <%- JSON.stringify(typeof infoGroups !== 'undefined' ? infoGroups : {}) %>,
                selectedBot: '<%- typeof jenis_bot !== 'undefined' ? jenis_bot : 'store' %>', 
                orderType: 'baru',
                selectedPackage: 'paket2',
                orderId: <%- JSON.stringify(typeof orderId !== 'undefined' ? orderId : '') %>,
                qrisData: <%- JSON.stringify(typeof qris !== 'undefined' ? qris : '') %>,
                harga: <%= typeof harga !== 'undefined' && harga ? harga : 0 %>,
                status: <%- JSON.stringify(typeof status !== 'undefined' ? status : 'PENDING') %>,
                timeLeft: 300,
                isLoading: false,

                
                isDarkMode: false,
                initTheme() {
                    localStorage.setItem('theme', 'light');
                    this.isDarkMode = false;
                    document.documentElement.classList.remove('dark');
                    document.documentElement.classList.add('light-theme');
                },
                toggleTheme() {
                    this.isDarkMode = !this.isDarkMode;
                    if (this.isDarkMode) {
                        document.documentElement.classList.add('dark');
                        document.documentElement.classList.remove('light-theme');
                        localStorage.setItem('theme', 'dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                        document.documentElement.classList.add('light-theme');
                        localStorage.setItem('theme', 'light');
                    }
                },
                init() {
                    this.initTheme();

                    if (this.view === 'checkout') {
                        this.startTimers();
                    }
                },

                async submitForm(e) {
                    this.isLoading = true;
                    const formData = new FormData(e.target);
                    const data = Object.fromEntries(formData.entries());
                    
                    try {
                        const res = await fetch('/checkout', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await res.json();
                        
                        if (result.success) {
                            this.orderId = result.orderId;
                            this.qrisData = result.qris;
                            this.harga = result.harga;
                            this.status = result.status || 'PENDING';
                            this.selectedBot = result.jenis_bot || this.selectedBot;
                            this.timeLeft = 300;
                            history.pushState(null, '', '/?checkout=' + this.orderId);
                            this.view = 'checkout';
                            this.startTimers();
                            setTimeout(() => { window.scrollTo({ top: 0, behavior: 'smooth' }); }, 100);
                        } else {
                            alert(result.message);
                        }
                    } catch(err) {
                        alert('Gagal menghubungi server. Coba beberapa saat lagi.');
                    }
                    this.isLoading = false;
                },

                startTimers() {
                    const timer = setInterval(() => { 
                        if(this.timeLeft > 0 && this.status === 'PENDING') {
                            this.timeLeft--;
                        } else {
                            clearInterval(timer);
                            if(this.timeLeft === 0 && this.status === 'PENDING') this.status = 'EXPIRED';
                        }
                    }, 1000);

                    const poll = setInterval(async () => {
                        if(['COMPLETED', 'SUCCESS', 'EXPIRED', 'CANCELLED', 'ERROR'].includes(this.status)) {
                            clearInterval(poll);
                            return;
                        }
                        try {
                            const res = await fetch('/status/' + this.orderId);
                            const data = await res.json();
                            this.status = data.status || this.status;
                        } catch(e) {}
                    }, 5000);
                },

                async cancelOrder() {
                    if(!confirm('Yakin ingin membatalkan pesanan ini?')) return;
                    this.isLoading = true;
                    try {
                        const res = await fetch('/cancel/' + this.orderId, { method: 'POST' });
                        const result = await res.json();
                        if(result.success) this.status = 'CANCELLED';
                    } catch(err) {
                        alert('Gagal membatalkan pesanan.');
                    }
                    this.isLoading = false;
                },

                formatTime() {
                    let m = Math.floor(this.timeLeft / 60);
                    let s = this.timeLeft % 60;
                    return `${m}:${s < 10 ? '0' : ''}${s}`;
                }
            }));
        });
    </script>
</head>

<body class="antialiased flex flex-col min-h-screen" x-data="ravenApp">

    <div class="fixed inset-0 grid-lines z-0 opacity-30"></div>

    <nav class="fixed top-0 w-full z-50 border-b border-border bg-base/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
            <div @click="view = 'home'; history.pushState(null, '', '/')" class="flex items-center gap-3 cursor-pointer">
                <img src="https://i.ibb.co.com/23h0hMBg/Beauty-Plus-20260323151557770-save.jpg" alt="Ravenzena Logo" class="w-8 h-8 rounded object-cover">
                <span class="font-bold text-lg text-white">Ravenzena<span class="text-accent">Bot</span></span>
            </div>

            <div class="flex items-center gap-4">
                <div class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-400 mr-2">
                    <a href="#" class="hover:text-white transition-colors">Fitur</a>
                    <a href="#" class="hover:text-white transition-colors">Harga</a>
                    <a href="#" class="hover:text-white transition-colors">Panduan</a>
                </div>
                
                <!-- Theme Toggle Button (Always Visible) -->
                <button @click="toggleTheme()" class="p-2 rounded-full bg-surface border border-border text-gray-400 hover:text-accent transition-all focus:outline-none">
                    <svg x-show="isDarkMode" class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0112 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                    <svg x-show="!isDarkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </button>

                <!-- Action Buttons (Desktop Only) -->
                <button x-show="view === 'home'" @click="view = 'order'; window.scrollTo({top:0, behavior:'smooth'})" class="hidden md:block bg-white text-black px-4 py-2 rounded-lg font-semibold hover:bg-gray-200 transition-all text-sm">Pesan Sekarang</button>
                <button x-show="view === 'order' || view === 'checkout'" @click="view = 'home'; history.pushState(null, '', '/'); window.scrollTo({top:0, behavior:'smooth'})" class="hidden md:block border border-white text-white px-4 py-2 rounded-lg font-semibold hover:bg-white/10 transition-all text-sm">Kembali ke Beranda</button>

                <!-- Hamburger Button -->
                <button @click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden text-white p-2 focus:outline-none ml-1">
                    <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                    <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        </div>

        <div x-show="mobileMenuOpen" x-transition class="md:hidden absolute top-16 left-0 w-full bg-base/95 border-b border-border flex flex-col p-4 gap-2 backdrop-blur-md">
            <button @click="view = 'home'; history.pushState(null, '', '/'); mobileMenuOpen = false; window.scrollTo({top:0, behavior:'smooth'})" class="w-full text-left text-white font-medium p-3 hover:bg-surface rounded-lg transition-colors">Beranda</button>
            <button @click="view = 'order'; mobileMenuOpen = false; window.scrollTo({top:0, behavior:'smooth'})" class="w-full text-left text-white font-medium p-3 hover:bg-surface rounded-lg transition-colors">Pesan Sekarang</button>
            
            <!-- Theme toggle moved to header -->

        </div>
    </nav>

    <div class="flex-grow">
        <main x-show="view === 'home'" class="relative z-10 pt-32 pb-24 px-6 flex flex-col items-center justify-center min-h-[80vh] text-center" x-transition x-cloak>
            <div class="max-w-3xl mx-auto">
                <div data-aos="fade-down" class="inline-block px-3 py-1 bg-accent/10 border border-accent/20 rounded-full mb-6">
                    <span class="text-xs font-medium text-accent">Pembaruan v4.0 sudah rilis 🎉</span>
                </div>
                
                <div data-aos="zoom-in" data-aos-delay="50" class="mb-10 rounded-3xl overflow-hidden border border-border shadow-2xl shadow-accent/10 w-fit mx-auto">
                    <img src="https://i.ibb.co.com/23h0hMBg/Beauty-Plus-20260323151557770-save.jpg" alt="Ravenzena Bot" class="w-64 h-auto object-cover">
                </div>
                
                <h1 data-aos="fade-up" class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">
                    Otomatisasi Grup Kamu <br /> 
                    <span class="text-gray-400">Tanpa Ribet.</span>
