    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ORDER VIEW                                         -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div x-show="view === 'order'" x-transition x-cloak>
        <div class="order-section">
            <div style="text-align:center; margin-bottom:50px;" data-aos="fade-up">
                <div class="sec-label"><i class="fas fa-cube"></i> Pilih Layanan</div>
                <h2 class="sec-heading">Paket bot untuk setiap kebutuhan.</h2>
                <p class="sec-sub">BOT CC & GUILD udh paket VVIP</p>
            </div>

            <!-- Bot selection -->
            <div class="bot-grid" data-aos="fade-up" data-aos-delay="100">
                <template x-for="(bot, index) in [
                    {id: 'store', name: 'Bot Store', desc: 'Cocok untuk jualan. Ada fitur simpan data, katalog produk, dan balasan otomatis.', icon: 'fas fa-store', color: 'rgba(14,165,233,.1)', colorTxt: 'var(--accent)'},
                    {id: 'v3', name: 'Bot Guild', desc: 'Bikin grup makin seru. Dilengkapi sistem level dan absensi.', icon: 'fas fa-users', color: 'rgba(139,92,246,.1)', colorTxt: '#8B5CF6'},
                    {id: 'cc', name: 'Bot CC', desc: 'Performa ekstra untuk grup ramai. Respons jauh lebih cepat dan stabil.', icon: 'fas fa-bolt', color: 'rgba(245,158,11,.1)', colorTxt: 'var(--warning)'}
                ]" :key="index">
                    <div class="bot-card" :class="selectedBot === bot.id ? 'active' : ''" @click="selectBot(bot.id)">
                        <div class="shimmer"></div>
                        <div class="bot-card-icon" :style="'background:' + bot.color + ';color:' + bot.colorTxt"><i :class="bot.icon"></i></div>
                        <div class="bot-card-title" x-text="bot.name"></div>
                        <div class="bot-card-desc" x-text="bot.desc"></div>
                    </div>
                </template>
            </div>

            <!-- Order form -->
            <div class="form-card" data-aos="fade-up" data-aos-delay="200">
                <!-- Loading overlay -->
                <div x-show="isLoading" class="loading-overlay" x-transition>
                    <div class="spinner"></div>
                    <p style="font-size:14px;font-weight:600;">Memproses Pesanan...</p>
                </div>

                <form @submit.prevent="submitForm" style="padding:32px;" :style="isLoading ? 'opacity:.5;pointer-events:none' : ''">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;">
                        <!-- Left column -->
                        <div>
                            <h4 style="font-size:15px;font-weight:700;margin-bottom:20px;display:flex;align-items:center;gap:10px;">
                                <span style="width:28px;height:28px;border-radius:6px;background:var(--bg-glass);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:12px;">1</span>
                                Informasi Grup
                            </h4>
                            <div style="display:flex;flex-direction:column;gap:16px;">
                                <div>
                                    <label class="form-label">Email Pengelola</label>
                                    <input type="email" name="email" required placeholder="email@contoh.com" class="form-input">
                                </div>
                                <div>
                                    <label class="form-label">Link Grup WhatsApp</label>
                                    <input type="url" name="link_group" required placeholder="https://chat.whatsapp.com/..." class="form-input">
                                    <p style="margin-top:8px;font-size:11px;font-weight:700;color:var(--danger);text-transform:uppercase;animation:dotPulse 1.5s infinite;">
                                        ⚠ Matikan persetujuan admin grup agar bot tidak error saat join
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Right column -->
                        <div>
                            <h4 style="font-size:15px;font-weight:700;margin-bottom:20px;display:flex;align-items:center;gap:10px;">
                                <span style="width:28px;height:28px;border-radius:6px;background:var(--bg-glass);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:12px;">2</span>
                                Detail Berlangganan
                            </h4>

                            <!-- Toggle baru/perpanjang -->
                            <div class="toggle-bar" style="margin-bottom:20px;">
                                <label>
                                    <input type="radio" name="tipe_order" value="baru" x-model="orderType" style="display:none">
                                    <div class="t-opt" :class="orderType === 'baru' ? 'on' : ''">Baru</div>
                                </label>
                                <label>
                                    <input type="radio" name="tipe_order" value="perpanjang" x-model="orderType" style="display:none">
                                    <div class="t-opt" :class="orderType === 'perpanjang' ? 'on' : ''">Perpanjang</div>
                                </label>
                            </div>

                            <!-- Warning perpanjang -->
                            <div x-show="orderType === 'perpanjang'" x-transition style="margin-bottom:16px;padding:12px 16px;background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.2);border-radius:12px;display:flex;align-items:center;gap:10px;">
                                <i class="fas fa-exclamation-circle" style="color:var(--warning);font-size:18px;"></i>
                                <p style="font-size:11px;font-weight:700;color:var(--warning);text-transform:uppercase;">Pastikan bot yang mau diperpanjang ada di dalam grup</p>
                            </div>

                            <!-- Package grid -->
                            <div class="pkg-grid">
                                <template x-for="(pkg, key) in (pricing[selectedBot] || {})" :key="key">
                                    <div class="pkg-card" :class="selectedPackage === key ? 'active' : ''" @click="selectedPackage = key">
                                        <div style="font-size:12px;color:var(--text-muted);font-weight:500;margin-bottom:4px;" x-text="pkg.nama"></div>
                                        <div style="font-size:20px;font-weight:800;" x-text="'Rp ' + pkg.harga.toLocaleString('id-ID')"></div>
                                    </div>
                                </template>
                            </div>

                            <input type="hidden" name="jenis_bot" x-model="selectedBot">
                            <input type="hidden" name="paket" x-model="selectedPackage">

                            <!-- Voucher -->
                            <div style="margin-bottom:20px;">
                                <label class="form-label">Kode Voucher (Opsional)</label>
                                <div style="display:flex;gap:10px;">
                                    <input type="text" name="voucher_code" x-model="voucherCode" placeholder="Masukkan kode promo" class="form-input" style="text-transform:uppercase;flex:1;" @input="resetVoucher()">
                                    <button type="button" @click="checkVoucher()" :disabled="isValidatingVoucher || !voucherCode" class="btn-accent" style="white-space:nowrap;">
                                        <span x-show="!isValidatingVoucher">Terapkan</span>
                                        <span x-show="isValidatingVoucher"><i class="fas fa-circle-notch fa-spin"></i></span>
                                    </button>
                                </div>
                                <p x-show="voucherMessage" style="margin-top:8px;font-size:12px;font-weight:600;" :style="voucherValid ? 'color:var(--success)' : 'color:var(--danger)'" x-text="voucherMessage"></p>
                            </div>

                            <!-- Total -->
                            <div style="padding:18px;background:var(--bg-glass);border:1px solid var(--border);border-radius:14px;display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
                                <span style="font-size:14px;color:var(--text-muted);">Total Pembayaran</span>
                                <div style="text-align:right;">
                                    <div x-show="voucherValid" style="font-size:12px;color:var(--text-dim);text-decoration:line-through;margin-bottom:2px;" x-text="'Rp ' + (pricing[selectedBot] && pricing[selectedBot][selectedPackage] ? pricing[selectedBot][selectedPackage].harga.toLocaleString('id-ID') : 0)"></div>
                                    <span style="font-size:24px;font-weight:900;" x-text="'Rp ' + finalPrice.toLocaleString('id-ID')"></span>
                                </div>
                            </div>

                            <!-- Error -->
                            <p x-show="formError" style="padding:12px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);border-radius:10px;font-size:13px;color:var(--danger);margin-bottom:16px;" x-text="formError"></p>

                            <!-- Submit -->
                            <button type="submit" :disabled="isLoading" class="btn-glow" style="width:100%;justify-content:center;border-radius:14px;padding:16px;font-size:16px;">
                                <span x-show="!isLoading">Lanjutkan ke Pembayaran <i class="fas fa-arrow-right" style="margin-left:4px;"></i></span>
                                <span x-show="isLoading"><i class="fas fa-circle-notch fa-spin"></i> Memproses...</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- CHECKOUT VIEW                                      -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div x-show="view === 'checkout'" x-transition x-cloak>
        <div class="checkout-section">
            <div class="form-card" style="text-align:center;padding:40px 28px;">

                <!-- Progress bar -->
                <div style="position:absolute;top:0;left:0;width:100%;height:4px;background:rgba(255,255,255,.06);border-radius:24px 24px 0 0;overflow:hidden;">
                    <div style="height:100%;background:var(--accent);transition:width 1s linear;" :style="'width:' + ((timeLeft/300)*100) + '%'"></div>
                </div>

                <h2 style="font-size:24px;font-weight:800;margin-bottom:8px;">Selesaikan Pembayaran</h2>
                <div style="color:var(--text-muted);font-size:14px;display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:24px;">
                    <span style="width:8px;height:8px;background:var(--warning);border-radius:50%;box-shadow:0 0 12px var(--warning);animation:dotPulse 1.5s infinite;"></span>
                    Menunggu pembayaran masuk...
                </div>

                <!-- Admin approval warning -->
                <div x-show="status === 'PENDING'" style="margin-bottom:24px;padding:14px;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);border-radius:12px;">
                    <p style="font-size:11px;font-weight:800;color:var(--danger);text-transform:uppercase;">⚠️ PENTING: Matikan persetujuan admin grup agar bot tidak error saat join ⚠️</p>
                </div>

                <!-- QRIS -->
                <div style="position:relative;display:inline-block;margin-bottom:24px;">
                    <div class="qris-wrap">
                        <img :src="'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(qrisData)" alt="QRIS" style="width:240px;height:240px;border-radius:8px;">
                    </div>

                    <!-- Status overlays -->
                    <div x-show="status !== 'PENDING'" class="status-overlay">
                        <template x-if="status === 'COMPLETED' || status === 'SUCCESS'">
                            <div style="text-align:center;">
                                <div style="width:56px;height:56px;border-radius:50%;background:rgba(16,185,129,.15);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;"><i class="fas fa-check" style="font-size:24px;color:var(--success);"></i></div>
                                <div style="font-size:20px;font-weight:700;color:var(--success);margin-bottom:8px;">Pembayaran Berhasil!</div>
                                <p style="color:var(--text-muted);font-size:13px;margin-bottom:16px;">Bot sedang bergabung ke grup kamu.</p>
                                <a :href="infoGroups[selectedBot] || '#'" target="_blank" class="btn-accent" style="display:block;text-decoration:none;text-align:center;margin-bottom:8px;">Gabung Grup Info Bot</a>
                                <button @click="goToHome()" class="btn-outline-hero" style="width:100%;justify-content:center;border-radius:10px;font-size:13px;padding:10px;">Kembali ke Beranda</button>
                            </div>
                        </template>
                        <template x-if="status === 'PAID'">
                            <div style="text-align:center;">
                                <div style="width:56px;height:56px;border-radius:50%;background:rgba(14,165,233,.15);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;animation:dotPulse 1.5s infinite;"><i class="fas fa-check-double" style="font-size:22px;color:var(--accent);"></i></div>
                                <div style="font-size:18px;font-weight:700;color:var(--accent);margin-bottom:8px;">Dana Diterima</div>
                                <p style="color:var(--text-muted);font-size:13px;margin-bottom:16px;">Pembayaranmu sudah masuk. Sistem sedang memproses...</p>
                                <a :href="infoGroups[selectedBot] || '#'" target="_blank" class="btn-accent" style="display:block;text-decoration:none;text-align:center;">Gabung Grup Info Bot</a>
                            </div>
                        </template>
                        <template x-if="status === 'WAITING'">
                            <div style="text-align:center;">
                                <div style="width:56px;height:56px;border-radius:50%;background:rgba(245,158,11,.15);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;"><i class="fas fa-sync fa-spin" style="font-size:22px;color:var(--warning);"></i></div>
                                <div style="font-size:18px;font-weight:700;color:var(--warning);margin-bottom:8px;">Sedang Proses</div>
                                <p style="color:var(--text-muted);font-size:13px;margin-bottom:16px;">Menunggu bot masuk ke grup kamu...</p>
                                <a :href="infoGroups[selectedBot] || '#'" target="_blank" class="btn-accent" style="display:block;text-decoration:none;text-align:center;">Gabung Grup Info Bot</a>
                            </div>
                        </template>
                        <template x-if="status === 'ERROR'">
                            <div style="text-align:center;">
                                <div style="width:56px;height:56px;border-radius:50%;background:rgba(239,68,68,.15);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;"><i class="fas fa-times" style="font-size:24px;color:var(--danger);"></i></div>
                                <div style="font-size:18px;font-weight:700;color:var(--danger);margin-bottom:8px;">Gagal Join Grup</div>
                                <p style="color:var(--text-muted);font-size:13px;margin-bottom:16px;">Ada kendala saat bot mencoba masuk. Hubungi admin.</p>
                                <button @click="goToHome()" class="btn-glow" style="border-radius:10px;font-size:13px;padding:10px 20px;">Kembali ke Beranda</button>
                            </div>
                        </template>
                        <template x-if="status === 'EXPIRED' || status === 'CANCELLED'">
                            <div style="text-align:center;">
                                <div style="font-size:18px;font-weight:700;color:var(--danger);margin-bottom:8px;" x-text="status === 'EXPIRED' ? 'Kedaluwarsa' : 'Dibatalkan'"></div>
                                <p style="color:var(--text-muted);font-size:13px;margin-bottom:16px;">Waktu pembayaran habis atau pesanan dibatalkan.</p>
                                <button @click="goToOrder()" class="btn-outline-hero" style="border-radius:10px;font-size:13px;padding:10px 20px;">Buat Pesanan Baru</button>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Order details -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;text-align:left;margin-bottom:24px;">
                    <div style="padding:16px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:12px;">
                        <span style="display:block;font-size:11px;color:var(--text-dim);margin-bottom:4px;">ID Pesanan</span>
                        <span style="font-family:var(--mono);font-size:13px;" x-text="orderId"></span>
                    </div>
                    <div style="padding:16px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:12px;">
                        <span style="display:block;font-size:11px;color:var(--text-dim);margin-bottom:4px;">Batas Waktu</span>
                        <span style="font-family:var(--mono);font-size:13px;color:var(--warning);" x-text="formatTime()"></span>
                    </div>
                    <div style="grid-column:1/-1;padding:18px;background:rgba(14,165,233,.04);border:1px solid rgba(14,165,233,.15);border-radius:12px;display:flex;justify-content:space-between;align-items:center;">
                        <span style="font-size:14px;color:var(--text-muted);">Total Tagihan</span>
                        <span style="font-size:22px;font-weight:800;" x-text="'Rp ' + harga.toLocaleString('id-ID')"></span>
                    </div>
                </div>

                <button @click="cancelOrder" style="background:none;border:none;color:var(--text-dim);text-decoration:underline;text-underline-offset:4px;font-size:13px;cursor:pointer;transition:color .2s;font-family:var(--font);" onmouseover="this.style.color='var(--danger)'" onmouseout="this.style.color='var(--text-dim)'">Batalkan Transaksi</button>

                <!-- Payment provider -->
                <div style="margin-top:28px;padding-top:20px;border-top:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column;align-items:center;gap:8px;">
                    <span style="font-size:11px;color:var(--text-dim);">Pembayaran didukung oleh:</span>
                    <div style="display:flex;align-items:center;gap:10px;opacity:.5;filter:grayscale(1);transition:all .3s;" onmouseover="this.style.opacity='1';this.style.filter='grayscale(0)'" onmouseout="this.style.opacity='.5';this.style.filter='grayscale(1)'">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/a/a2/Logo_QRIS.svg" alt="QRIS" style="height:20px;">
                        <span style="font-size:13px;font-weight:700;">MustikaPay</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- FOOTER                                             -->
    <!-- ═══════════════════════════════════════════════════ -->
    <footer class="site-footer">
        <div class="footer-grid">
            <div>
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
                    <img src="<%= siteSettings && siteSettings.logoUrl ? siteSettings.logoUrl : '/favicon.png' %>" alt="Logo" style="width:28px;height:28px;border-radius:6px;object-fit:cover;">
                    <span style="font-weight:800;font-size:18px;"><%= siteSettings && siteSettings.siteName ? siteSettings.siteName : 'Ravenzena Bot' %></span>
                </div>
                <p style="color:var(--text-muted);font-size:14px;max-width:360px;line-height:1.7;">
                    Solusi bot WhatsApp cerdas untuk mengelola dan meramaikan grup komunitasmu. Praktis, cepat, dan terpercaya.
                </p>
            </div>
            <div>
                <div class="footer-title">Layanan</div>
                <ul class="footer-links">
                    <li><a href="#features">Fitur Bot</a></li>
                    <li><a href="#" @click.prevent="goToOrder()">Harga & Paket</a></li>
                    <li><span style="color:var(--text-dim);font-size:13px;">Status: <span style="color:var(--success)">Normal</span></span></li>
                </ul>
            </div>
            <div>
                <div class="footer-title">Bantuan</div>
                <ul class="footer-links">
                    <li><a href="#" @click.prevent="goToOrder()">Hubungi Admin</a></li>
                    <li><span style="color:var(--text-dim);font-size:13px;">Syarat & Ketentuan</span></li>
                    <li><span style="color:var(--text-dim);font-size:13px;">Kebijakan Privasi</span></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; 2026 Ravenzena Bot. Hak Cipta Dilindungi.</span>
            <div style="display:flex;align-items:center;gap:6px;">
                <span class="status-dot"></span>
                <span>Semua Sistem Normal</span>
            </div>
        </div>
    </footer>

</body>
</html>