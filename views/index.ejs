        </main>

        <main x-show="view === 'order'" class="relative z-10 pt-32 pb-24 px-6" x-transition x-cloak>
            <div class="max-w-5xl mx-auto">
                <div data-aos="fade-right" class="mb-10 text-center md:text-left">
                    <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">Pilih Paket Bot</h1>
                    <p class="text-gray-400">Pilih jenis layanan yang paling sesuai dengan kebutuhan grup komunitasmu.</p>
                    <p class="text-accent text-sm mt-2 font-medium">BOT CC & GUILD udh paket VVIP</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                    <template x-for="(bot, index) in [
                        {id: 'store', name: 'Bot Store', desc: 'Cocok untuk jualan. Ada fitur simpan data, katalog produk, dan balasan otomatis.', icon: 'M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7c-2 0-3 1-3 3z'},
                        {id: 'v3', name: 'Bot Guild', desc: 'Bikin grup makin seru. Dilengkapi sistem level, dan absensi.', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z'},
                        {id: 'cc', name: 'Bot CC', desc: 'Performa ekstra untuk grup ramai. Respons jauh lebih cepat dan stabil.', icon: 'M13 10V3L4 14h7v7l9-11h-7z'}
