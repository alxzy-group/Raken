                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-8">
                                <div>
                                    <h4 class="text-white font-semibold text-sm mb-6 flex items-center gap-3">
                                        <span class="w-6 h-6 rounded bg-surface border border-border flex items-center justify-center text-xs">2</span>
                                        Detail Berlangganan
                                    </h4>

                                    <div class="flex p-1 bg-surface border border-border rounded-lg mb-6">
                                        <label class="flex-1 cursor-pointer">
                                            <input type="radio" name="tipe_order" value="baru" x-model="orderType" class="sr-only">
                                            <div :class="orderType === 'baru' ? 'bg-accent text-white shadow-sm' : 'text-gray-400 hover:text-gray-200'" class="py-2 text-center text-sm font-medium rounded transition-all">Baru</div>
                                        </label>
                                        <label class="flex-1 cursor-pointer">
                                            <input type="radio" name="tipe_order" value="perpanjang" x-model="orderType" class="sr-only">
