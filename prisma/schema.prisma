generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Order {
  id             String    @id
  status         String
  product        String?
  price          Float?
  userAccount    String?
  pakasir        String?
  serverDetails  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  // Raken-main columns
  email          String?
  link_group     String?
  info_group     String?
  jenis_bot      String?
  tipe_order     String?
  paket          String?
  durasi_hari    String?
  harga          Int?
  payment_number String?
  expired_at     String?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt

  // Relations
  group          Group?
}

model Group {
  id          String   @id @default(uuid())
  orderId     String   @unique
  name        String?
  photo       String?
  jid         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id])
}

model ActiveGroup {
  id          Int      @id @default(autoincrement())
  jid         String
  jenisBot    String
  name        String?
  photo       String?
  expiredAt   String?
  memberCount Int?     @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([jid, jenisBot])
}

model Setting {
  key   String @id
  value String
}

model AppConfig {
  key   String @id
  value String
}

model GroupSetting {
  chatId    String  @id
  antiLink  Boolean @default(false)
  antiNSFW  Boolean @default(false)
  antiPromo Boolean @default(false)
  antiAdmin Boolean @default(false)
}

model NodeSpecification {
  type     String @id
  title    String
  subtitle String
  cpu      String
  ram      String
  disk     String
  os       String
  net      String
  loc      String
}

model PanelConfig {
  type String @id
  url  String
  key  String
}

model Product {
  id         Int    @id @default(autoincrement())
  type       String
  name       String
  memory     String
  disk       String @default("0")
  cpu        Int    @default(0)
  price      Float
  nestId     Int    @default(0)
  eggId      Int    @default(0)
  locationId Int    @default(0)

  @@unique([type, name])
}

model Voucher {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  discount  Float
  type      String    @default("flat")
  maxUsage  Int       @default(1)
  usedCount Int       @default(0)
  expiry    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}
